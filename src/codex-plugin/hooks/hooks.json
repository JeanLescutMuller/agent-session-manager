{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_EVENT=start \"$HOME/opt/agent-session-manager/lifecycle_generation.sh\"",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_EVENT=end \"$HOME/opt/agent-session-manager/lifecycle_generation.sh\"",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
