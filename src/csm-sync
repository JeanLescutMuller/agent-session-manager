#!/usr/bin/env bash
# csm-sync - Sync Claude Code sessions between local disk and a remote host over SSH.
#
# Optional. If no remote host is configured in ~/.claude/csm-settings.json, exits
# silently. There is no shared filesystem or mount assumed - all remote access goes
# through `ssh`/`rsync`. Conflict detection still uses byte-level `cmp`, but against
# a locally-fetched temp copy of the remote file rather than a mounted path.
#
# Usage:
#   csm-sync [uuid]              Sync (bidirectional). Only 1 session if [uuid] is provided. Otherwise all sessions.
#   csm-sync --push [uuid]       Push local → remote only
#   csm-sync --pull [uuid]       Pull remote → local only
#   csm-sync --check [uuid]      Dry run: report status without copying

set -euo pipefail

GRAY='\033[90m'
RST='\033[0m'

# -- Settings -----------------------------------------------------------------

CSM_SETTINGS="$HOME/.claude/csm-settings.json"

read_setting() {
    python3 -c "
import json, os
try:
    s = json.load(open('$CSM_SETTINGS'))
    v = os.path.expanduser(s.get('$1', ''))
    print(v)
except Exception:
    print('')
" 2>/dev/null || echo ""
}

# Like read_setting, but does NOT run os.path.expanduser - a leading '~' in a
# remote path means the remote user's home, not the local one, and must be
# expanded against $REMOTE_HOME (fetched over SSH) instead.
read_setting_raw() {
    python3 -c "
import json
try:
    s = json.load(open('$CSM_SETTINGS'))
    print(s.get('$1', ''))
except Exception:
    print('')
" 2>/dev/null || echo ""
}

LOCAL_PROJECTS=$(read_setting local_projects_dir)
LOCAL_INDEX=$(read_setting local_index_dir)
REMOTE_SSH_HOST=$(read_setting remote_ssh_host)
REMOTE_SSH_USER=$(read_setting remote_ssh_user)
REMOTE_SSH_PORT=$(read_setting remote_ssh_port)
REMOTE_PROJECTS_DIR=$(read_setting_raw remote_projects_dir)
REMOTE_INDEX_DIR=$(read_setting_raw remote_index_dir)

: "${LOCAL_PROJECTS:=$HOME/.claude/projects}"
: "${LOCAL_INDEX:=$HOME/.claude/session-index-local}"
: "${REMOTE_PROJECTS_DIR:=~/.claude/projects}"
: "${REMOTE_INDEX_DIR:=~/.claude/session-index-local}"

# Exit if remote not configured
if [ -z "$REMOTE_SSH_HOST" ]; then
    echo "csm-sync: remote not configured in ~/.claude/csm-settings.json (skipping)"
    exit 0
fi

SSH_PORT="${REMOTE_SSH_PORT:-22}"
SSH_TARGET="$REMOTE_SSH_HOST"
[ -n "$REMOTE_SSH_USER" ] && SSH_TARGET="$REMOTE_SSH_USER@$REMOTE_SSH_HOST"
RSYNC_RSH="ssh -p $SSH_PORT -o BatchMode=yes -o ConnectTimeout=10"

remote_ssh() {
    ssh -p "$SSH_PORT" -o BatchMode=yes -o ConnectTimeout=10 "$SSH_TARGET" "$@"
}

# -- Parse args ---------------------------------------------------------------

DIRECTION="both"  # both, push, pull
DRY_RUN=false
TARGET_UUID=""

while [ $# -gt 0 ]; do
    case "$1" in
        --push) DIRECTION="push"; shift ;;
        --pull) DIRECTION="pull"; shift ;;
        --check) DRY_RUN=true; shift ;;
        --*) echo "Unknown flag: $1" >&2; exit 1 ;;
        *)
            if [ -z "$TARGET_UUID" ]; then
                TARGET_UUID="$1"
            fi
            shift ;;
    esac
done

# -- Check remote reachability + resolve ~ against the remote's own $HOME -----

REMOTE_HOME=$(remote_ssh 'echo $HOME' 2>/dev/null) || {
    echo "WARNING: cannot reach remote $SSH_TARGET (port $SSH_PORT)" >&2
    exit 1
}

expand_remote_path() {
    case "$1" in
        "~"*) printf '%s\n' "${REMOTE_HOME}${1#\~}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

REMOTE_PROJECTS_ABS=$(expand_remote_path "$REMOTE_PROJECTS_DIR")
REMOTE_INDEX_ABS=$(expand_remote_path "$REMOTE_INDEX_DIR")

if ! remote_ssh "test -d '$REMOTE_PROJECTS_ABS'" 2>/dev/null; then
    echo "WARNING: remote projects dir not accessible: $SSH_TARGET:$REMOTE_PROJECTS_ABS" >&2
    exit 1
fi

# -- Counters -------------------------------------------------------------------

SYNCED=0
SKIPPED=0
CONFLICTS=0
ERRORS=0

# -- Byte-level reconciliation (both files already confirmed to exist) --------
#
# REMOTE_FILE here is always a LOCAL path - a temp copy fetched from the real
# remote file by the caller. This function never touches the network; callers
# are responsible for fetching before and pushing back after.

sync_one_file() {
    local LOCAL_FILE="$1"
    local REMOTE_FILE="$2"
    local DIRECTION="$3"

    local LOCAL_SIZE REMOTE_SIZE LOCAL_MTIME REMOTE_MTIME
    LOCAL_SIZE=$(stat -c%s "$LOCAL_FILE" 2>/dev/null || stat -f%z "$LOCAL_FILE" 2>/dev/null || echo "")
    REMOTE_SIZE=$(stat -c%s "$REMOTE_FILE" 2>/dev/null || stat -f%z "$REMOTE_FILE" 2>/dev/null || echo "")

    if [ -z "$LOCAL_SIZE" ] || [ -z "$REMOTE_SIZE" ]; then
        ERRORS=$((ERRORS + 1))
        return
    fi

    # Fast path: same size + same mtime → identical (rsync -a preserves mtime)
    if [ "$LOCAL_SIZE" -eq "$REMOTE_SIZE" ]; then
        LOCAL_MTIME=$(stat -c%Y "$LOCAL_FILE" 2>/dev/null || stat -f%m "$LOCAL_FILE" 2>/dev/null || echo "0")
        REMOTE_MTIME=$(stat -c%Y "$REMOTE_FILE" 2>/dev/null || stat -f%m "$REMOTE_FILE" 2>/dev/null || echo "0")
        if [ "$LOCAL_MTIME" -eq "$REMOTE_MTIME" ]; then
            SKIPPED=$((SKIPPED + 1))
            return
        fi
        if cmp -s "$LOCAL_FILE" "$REMOTE_FILE" 2>/dev/null; then
            SKIPPED=$((SKIPPED + 1))
            return
        fi
    fi

    # Check if one is a prefix of the other
    local SMALLER_SIZE=$((LOCAL_SIZE < REMOTE_SIZE ? LOCAL_SIZE : REMOTE_SIZE))
    local CMP_OUT
    CMP_OUT=$(cmp -n "$SMALLER_SIZE" "$LOCAL_FILE" "$REMOTE_FILE" 2>&1) || true

    if echo "$CMP_OUT" | grep -q "Input/output error"; then
        ERRORS=$((ERRORS + 1))
        return
    fi

    if [ -z "$CMP_OUT" ]; then
        # One is a prefix of the other
        if [ "$LOCAL_SIZE" -lt "$REMOTE_SIZE" ]; then
            if [ "$DIRECTION" = "push" ]; then
                SKIPPED=$((SKIPPED + 1))
                return
            fi
            if $DRY_RUN; then
                echo "  PULL $(basename "$LOCAL_FILE") (remote → local, remote has $((REMOTE_SIZE - LOCAL_SIZE)) more bytes)"
                return
            fi
            cp -p "$REMOTE_FILE" "$LOCAL_FILE" && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
        else
            if [ "$DIRECTION" = "pull" ]; then
                SKIPPED=$((SKIPPED + 1))
                return
            fi
            if $DRY_RUN; then
                echo "  PUSH $(basename "$LOCAL_FILE") (local → remote, local has $((LOCAL_SIZE - REMOTE_SIZE)) more bytes)"
                return
            fi
            cp -p "$LOCAL_FILE" "$REMOTE_FILE" && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
        fi
    else
        # Diverged (JSONL/lifecycle only, index is handled separately)
        local L
        L=$(echo "$CMP_OUT" | sed -n 's/.*line \([0-9]*\).*/\1/p' | head -1)
        L=${L:-1}
        L=$((L - 1))
        [ "$L" -lt 0 ] && L=0
        local LOCAL_LINES REMOTE_LINES
        LOCAL_LINES=$(wc -l < "$LOCAL_FILE" 2>/dev/null || echo "0")
        REMOTE_LINES=$(wc -l < "$REMOTE_FILE" 2>/dev/null || echo "0")
        local TIMESTAMP
        TIMESTAMP=$(date +%Y%m%d_%H%M%S)

        CONFLICTS=$((CONFLICTS + 1))
        local YELLOW='\033[33m'
        local RESET='\033[0m'

        if $DRY_RUN; then
            echo -e "  ${YELLOW}⚠️ CONFLICT: $(basename "$LOCAL_FILE") diverged at line $((L + 1)) (local: $LOCAL_LINES lines, remote: $REMOTE_LINES lines)${RESET}"
            return
        fi

        # Save extra lines from the smaller file, keep the larger
        local EXTRA_FILE UUID_SHORT EXTRA_LINES KEPT_FROM
        UUID_SHORT=$(basename "$LOCAL_FILE" .jsonl)
        local LOCAL_DIR
        LOCAL_DIR="$(dirname "$LOCAL_FILE")"
        if [ "$LOCAL_SIZE" -le "$REMOTE_SIZE" ]; then
            EXTRA_LINES=$((LOCAL_LINES - L))
            EXTRA_FILE="${LOCAL_DIR}/${UUID_SHORT}.extra-local-${TIMESTAMP}.md"
            tail -n "+$((L + 1))" "$LOCAL_FILE" > "$EXTRA_FILE"
            cp -p "$REMOTE_FILE" "$LOCAL_FILE"
            KEPT_FROM="remote"
        else
            EXTRA_LINES=$((REMOTE_LINES - L))
            EXTRA_FILE="${LOCAL_DIR}/${UUID_SHORT}.extra-remote-${TIMESTAMP}.md"
            tail -n "+$((L + 1))" "$REMOTE_FILE" > "$EXTRA_FILE"
            cp -p "$LOCAL_FILE" "$REMOTE_FILE"
            KEPT_FROM="local"
        fi
        echo -e "  ${YELLOW}⚠️ CONFLICT: $(basename "$LOCAL_FILE") diverged at line $((L + 1)) (local: $LOCAL_LINES lines, remote: $REMOTE_LINES lines)"
        echo -e "      Saved $EXTRA_LINES extra lines to $(basename "$EXTRA_FILE")"
        echo -e "      Keeping larger file from $KEPT_FROM${RESET}"
    fi
}

# -- JSONL/lifecycle file sync over SSH (handles existence + byte reconciliation) --

fetch_and_reconcile_jsonl() {
    local local_file="$1" remote_abs="$2" direction="$3" work="$4"
    local tmp="$work/fetch.$$.$RANDOM"

    if ! rsync -az -e "$RSYNC_RSH" "$SSH_TARGET:$remote_abs" "$tmp" 2>/dev/null; then
        # Remote file doesn't exist
        rm -f "$tmp"
        if [ -f "$local_file" ]; then
            if [ "$direction" = "pull" ]; then
                SKIPPED=$((SKIPPED + 1))
                return
            fi
            if $DRY_RUN; then
                echo "  PUSH $(basename "$local_file") (exists locally, missing on remote)"
                return
            fi
            rsync -az -e "$RSYNC_RSH" "$local_file" "$SSH_TARGET:$remote_abs" 2>/dev/null \
                && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
        fi
        return
    fi

    if [ ! -f "$local_file" ]; then
        # Remote exists, local doesn't
        if [ "$direction" = "push" ]; then
            SKIPPED=$((SKIPPED + 1))
        elif $DRY_RUN; then
            echo "  PULL $(basename "$local_file") (exists on remote, missing locally)"
        else
            mkdir -p "$(dirname "$local_file")"
            cp -p "$tmp" "$local_file" && SYNCED=$((SYNCED + 1))
        fi
        rm -f "$tmp"
        return
    fi

    # Both exist: reuse the byte-level conflict resolution logic above
    sync_one_file "$local_file" "$tmp" "$direction"

    # Whatever sync_one_file decided (skip / pull-into-local / push-into-tmp /
    # conflict-resolved-into-tmp) push the resulting tmp state back up. This is
    # a no-op when tmp is unchanged (rsync skips identical content).
    if [ "$direction" != "pull" ] && ! $DRY_RUN; then
        rsync -az -e "$RSYNC_RSH" "$tmp" "$SSH_TARGET:$remote_abs" 2>/dev/null || ERRORS=$((ERRORS + 1))
    fi
    rm -f "$tmp"
}

# -- Index file sync over SSH (newest-wins, no cmp needed) ---------------------

reconcile_index_pair() {
    local local_file="$1" remote_abs="$2" lmt="$3" rmt="$4" direction="$5"
    local rel; rel=$(basename "$local_file")

    if [ -n "$lmt" ] && [ -z "$rmt" ]; then
        if [ "$direction" = "pull" ]; then SKIPPED=$((SKIPPED + 1)); return; fi
        if $DRY_RUN; then echo "  PUSH $rel (index, exists locally, missing on remote)"; return; fi
        rsync -az -e "$RSYNC_RSH" "$local_file" "$SSH_TARGET:$remote_abs" 2>/dev/null \
            && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
        return
    fi
    if [ -z "$lmt" ] && [ -n "$rmt" ]; then
        if [ "$direction" = "push" ]; then SKIPPED=$((SKIPPED + 1)); return; fi
        if $DRY_RUN; then echo "  PULL $rel (index, exists on remote, missing locally)"; return; fi
        mkdir -p "$(dirname "$local_file")"
        rsync -az -e "$RSYNC_RSH" "$SSH_TARGET:$remote_abs" "$local_file" 2>/dev/null \
            && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
        return
    fi
    if [ -z "$lmt" ] && [ -z "$rmt" ]; then
        return  # neither exists
    fi

    # Both exist: newest wins
    if awk -v a="$lmt" -v b="$rmt" 'BEGIN{exit !(a>b)}'; then
        if [ "$direction" = "pull" ]; then SKIPPED=$((SKIPPED + 1)); return; fi
        if $DRY_RUN; then echo "  PUSH $rel (index, local → remote, local is newer)"; return; fi
        rsync -az -e "$RSYNC_RSH" "$local_file" "$SSH_TARGET:$remote_abs" 2>/dev/null \
            && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
    elif awk -v a="$rmt" -v b="$lmt" 'BEGIN{exit !(a>b)}'; then
        if [ "$direction" = "push" ]; then SKIPPED=$((SKIPPED + 1)); return; fi
        if $DRY_RUN; then echo "  PULL $rel (index, remote → local, remote is newer)"; return; fi
        rsync -az -e "$RSYNC_RSH" "$SSH_TARGET:$remote_abs" "$local_file" 2>/dev/null \
            && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
    else
        SKIPPED=$((SKIPPED + 1))
    fi
}

# -- Local manifest: relpath<TAB>size<TAB>mtime, portable stat -----------------

local_manifest() {
    local root="$1"; shift
    find "$root" "$@" -type f 2>/dev/null | while IFS= read -r f; do
        local sz mt
        sz=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null || echo "")
        mt=$(stat -c%Y "$f" 2>/dev/null || stat -f%m "$f" 2>/dev/null || echo "")
        [ -z "$sz" ] || [ -z "$mt" ] && continue
        printf '%s\t%s\t%s\n' "${f#"$root"/}" "$sz" "$mt"
    done
}

# -- Sync one session by UUID --------------------------------------------------

sync_session() {
    local uuid="$1" direction="$2"

    local local_slug=""
    for d in "$LOCAL_PROJECTS"/*/; do
        [ -f "${d}${uuid}.jsonl" ] && local_slug=$(basename "$d") && break
    done

    local slug="$local_slug"
    if [ -z "$slug" ]; then
        slug=$(remote_ssh "find '$REMOTE_PROJECTS_ABS' -maxdepth 2 -name '${uuid}.jsonl' 2>/dev/null | head -1 | xargs -r dirname | xargs -r basename" 2>/dev/null || true)
    fi
    [ -z "$slug" ] && return

    local work; work=$(mktemp -d)

    fetch_and_reconcile_jsonl "$LOCAL_PROJECTS/$slug/${uuid}.jsonl" "$REMOTE_PROJECTS_ABS/$slug/${uuid}.jsonl" "$direction" "$work"
    fetch_and_reconcile_jsonl "$LOCAL_PROJECTS/$slug/${uuid}.lifecycle.jsonl" "$REMOTE_PROJECTS_ABS/$slug/${uuid}.lifecycle.jsonl" "$direction" "$work"

    local local_idx="$LOCAL_INDEX/${uuid}.json"
    local remote_idx_abs="$REMOTE_INDEX_ABS/${uuid}.json"
    local lmt="" rmt=""
    [ -f "$local_idx" ] && lmt=$(stat -c%Y "$local_idx" 2>/dev/null || stat -f%m "$local_idx" 2>/dev/null || echo "")
    local rstat
    rstat=$(remote_ssh "stat -c '%Y' '$remote_idx_abs' 2>/dev/null" 2>/dev/null || true)
    [ -n "$rstat" ] && rmt="$rstat"
    reconcile_index_pair "$local_idx" "$remote_idx_abs" "$lmt" "$rmt" "$direction"

    rm -rf "$work"
}

# -- Sync an entire directory (all sessions): manifest diff + batched transfer --

reconcile_dir() {
    local local_root="$1" remote_root="$2" mode="$3" direction="$4"
    local work; work=$(mktemp -d)

    if [ "$mode" = "jsonl" ]; then
        local_manifest "$local_root" -name '*.jsonl' -not -name 'agent-*' > "$work/local.tsv"
        remote_ssh "find '$remote_root' -name '*.jsonl' -not -name 'agent-*' -printf '%P\t%s\t%T@\n' 2>/dev/null" > "$work/remote.tsv" 2>/dev/null || true
    else
        local_manifest "$local_root" -maxdepth 1 -name '*.json' > "$work/local.tsv"
        remote_ssh "find '$remote_root' -maxdepth 1 -name '*.json' -printf '%P\t%s\t%T@\n' 2>/dev/null" > "$work/remote.tsv" 2>/dev/null || true
    fi

    python3 - "$work/local.tsv" "$work/remote.tsv" > "$work/plan.tsv" <<'PYEOF'
import sys

def load(path):
    d = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.rstrip("\n")
                if not line:
                    continue
                p, sz, mt = line.split("\t")
                d[p] = (int(float(sz)), float(mt))
    except FileNotFoundError:
        pass
    return d

local = load(sys.argv[1])
remote = load(sys.argv[2])

for p in sorted(set(local) | set(remote)):
    l, r = local.get(p), remote.get(p)
    if l and not r:
        print(f"PUSH\t{p}\t{l[0]}\t{l[1]}\t-\t-")
    elif r and not l:
        print(f"PULL\t{p}\t-\t-\t{r[0]}\t{r[1]}")
    else:
        lsz, lmt = l
        rsz, rmt = r
        if lsz == rsz and abs(lmt - rmt) < 2:
            print(f"SKIP\t{p}\t{lsz}\t{lmt}\t{rsz}\t{rmt}")
        else:
            print(f"CHECK\t{p}\t{lsz}\t{lmt}\t{rsz}\t{rmt}")
PYEOF

    local push_list="$work/push.txt" pull_list="$work/pull.txt"
    : > "$push_list"; : > "$pull_list"
    local total i=0
    total=$(wc -l < "$work/plan.tsv" | tr -d ' ')

    while IFS=$'\t' read -r action rel lsz lmt rsz rmt; do
        i=$((i + 1))
        case "$action" in
            SKIP)
                SKIPPED=$((SKIPPED + 1)) ;;
            PUSH)
                if [ "$direction" = "pull" ]; then
                    SKIPPED=$((SKIPPED + 1))
                elif $DRY_RUN; then
                    echo "  PUSH $rel"
                else
                    echo "$rel" >> "$push_list"
                fi ;;
            PULL)
                if [ "$direction" = "push" ]; then
                    SKIPPED=$((SKIPPED + 1))
                elif $DRY_RUN; then
                    echo "  PULL $rel"
                else
                    echo "$rel" >> "$pull_list"
                fi ;;
            CHECK)
                if [ "$mode" = "index" ]; then
                    reconcile_index_pair "$local_root/$rel" "$remote_root/$rel" "$lmt" "$rmt" "$direction"
                else
                    fetch_and_reconcile_jsonl "$local_root/$rel" "$remote_root/$rel" "$direction" "$work"
                fi ;;
        esac
        if [ $((i % 100)) -eq 0 ]; then
            echo -e "  ${GRAY}[$i/$total] $mode files processed...${RST}" >&2
        fi
    done < "$work/plan.tsv"

    if [ -s "$push_list" ]; then
        local n; n=$(wc -l < "$push_list" | tr -d ' ')
        if rsync -az -e "$RSYNC_RSH" --files-from="$push_list" "$local_root/" "$SSH_TARGET:$remote_root/" 2>/dev/null; then
            SYNCED=$((SYNCED + n))
        else
            ERRORS=$((ERRORS + n))
        fi
    fi
    if [ -s "$pull_list" ]; then
        local n; n=$(wc -l < "$pull_list" | tr -d ' ')
        mkdir -p "$local_root"
        if rsync -az -e "$RSYNC_RSH" --files-from="$pull_list" "$SSH_TARGET:$remote_root/" "$local_root/" 2>/dev/null; then
            SYNCED=$((SYNCED + n))
        else
            ERRORS=$((ERRORS + n))
        fi
    fi

    rm -rf "$work"
}

# -- Main ---------------------------------------------------------------------

if [ -n "$TARGET_UUID" ]; then
    sync_session "$TARGET_UUID" "$DIRECTION"
else
    echo "csm-sync: syncing $LOCAL_PROJECTS (LOCAL) ↔ $SSH_TARGET:$REMOTE_PROJECTS_ABS (REMOTE)"
    echo ""
    echo "  Stage 1: session files (JSONL + lifecycle)"
    reconcile_dir "$LOCAL_PROJECTS" "$REMOTE_PROJECTS_ABS" "jsonl" "$DIRECTION"
    echo "  Stage 2: index files"
    reconcile_dir "$LOCAL_INDEX" "$REMOTE_INDEX_ABS" "index" "$DIRECTION"
fi

echo ""
if [ "$SYNCED" -gt 0 ] || [ "$CONFLICTS" -gt 0 ] || [ "$ERRORS" -gt 0 ]; then
    echo "  Done: $SYNCED synced, $SKIPPED unchanged, $CONFLICTS conflicts, $ERRORS errors"
else
    echo "  Done: all files up to date, $SKIPPED checked"
fi
