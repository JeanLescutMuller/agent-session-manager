#!/usr/bin/env bash
# csm-sync - Sync the local CSM index with a remote host over SSH.
#
# Optional. If no remote host is configured in ~/.csm/settings.json, exits
# silently. There is no shared filesystem or mount assumed - all remote access
# goes through `ssh`/`rsync`.
#
# Index-only: this only syncs ~/.csm/indexes/*.json, never the raw .jsonl
# session transcripts or .lifecycle.jsonl sidecars. The index already embeds
# full conversation text, so nothing needed for search/`/inject` is lost by
# not syncing the raw files - and since index files are always fully
# regenerated by `csm reindex`, newest-mtime-wins is the only reconciliation
# rule ever needed (no byte-level conflict resolution, unlike an earlier
# version of this script that also synced raw session files).
#
# Every real (non-dry-run) run that reaches the reachability check appends one
# line to ~/.csm/sync-log.jsonl recording the outcome - `csm resume` reads
# this to warn when the local index is stale relative to the remote.
#
# Usage:
#   csm-sync [uuid]              Sync (bidirectional). Only 1 session if [uuid] is provided. Otherwise all sessions.
#   csm-sync --push [uuid]       Push local → remote only
#   csm-sync --pull [uuid]       Pull remote → local only
#   csm-sync --check [uuid]      Dry run: report status without copying

set -euo pipefail

GRAY='\033[90m'
RST='\033[0m'

# -- Settings -----------------------------------------------------------------

CSM_SETTINGS="$HOME/.csm/settings.json"

read_setting() {
    python3 -c "
import json, os
try:
    s = json.load(open('$CSM_SETTINGS'))
    v = os.path.expanduser(s.get('$1', ''))
    print(v)
except Exception:
    print('')
" 2>/dev/null || echo ""
}

# Like read_setting, but does NOT run os.path.expanduser - a leading '~' in a
# remote path means the remote user's home, not the local one, and must be
# expanded against $REMOTE_HOME (fetched over SSH) instead.
read_setting_raw() {
    python3 -c "
import json
try:
    s = json.load(open('$CSM_SETTINGS'))
    print(s.get('$1', ''))
except Exception:
    print('')
" 2>/dev/null || echo ""
}

LOCAL_INDEX=$(read_setting local_index_dir)
REMOTE_SSH_HOST=$(read_setting remote_ssh_host)
REMOTE_SSH_USER=$(read_setting remote_ssh_user)
REMOTE_SSH_PORT=$(read_setting remote_ssh_port)
REMOTE_INDEX_DIR=$(read_setting_raw remote_index_dir)

: "${LOCAL_INDEX:=$HOME/.csm/indexes}"
: "${REMOTE_INDEX_DIR:=~/.csm/indexes}"

SYNC_LOG="$HOME/.csm/sync-log.jsonl"

write_sync_log() {
    # write_sync_log <outcome> [synced] [errors] - no-op during --check
    $DRY_RUN && return
    mkdir -p "$(dirname "$SYNC_LOG")"
    python3 -c "
import json, sys
from datetime import datetime, timezone
entry = {'timestamp': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'), 'outcome': sys.argv[1]}
if len(sys.argv) > 3:
    entry['synced'] = int(sys.argv[2])
    entry['errors'] = int(sys.argv[3])
with open(sys.argv[4], 'a') as f:
    f.write(json.dumps(entry) + '\n')
" "$1" "${2:-0}" "${3:-0}" "$SYNC_LOG" 2>/dev/null || true
}

# Exit if remote not configured
if [ -z "$REMOTE_SSH_HOST" ]; then
    echo "csm-sync: remote not configured in ~/.csm/settings.json (skipping)"
    exit 0
fi

SSH_PORT="${REMOTE_SSH_PORT:-22}"
SSH_TARGET="$REMOTE_SSH_HOST"
[ -n "$REMOTE_SSH_USER" ] && SSH_TARGET="$REMOTE_SSH_USER@$REMOTE_SSH_HOST"
RSYNC_RSH="ssh -p $SSH_PORT -o BatchMode=yes -o ConnectTimeout=10"

remote_ssh() {
    ssh -p "$SSH_PORT" -o BatchMode=yes -o ConnectTimeout=10 "$SSH_TARGET" "$@"
}

# -- Parse args ---------------------------------------------------------------

DIRECTION="both"  # both, push, pull
DRY_RUN=false
TARGET_UUID=""

while [ $# -gt 0 ]; do
    case "$1" in
        --push) DIRECTION="push"; shift ;;
        --pull) DIRECTION="pull"; shift ;;
        --check) DRY_RUN=true; shift ;;
        --*) echo "Unknown flag: $1" >&2; exit 1 ;;
        *)
            if [ -z "$TARGET_UUID" ]; then
                TARGET_UUID="$1"
            fi
            shift ;;
    esac
done

# -- Check remote reachability + resolve ~ against the remote's own $HOME -----

REMOTE_HOME=$(remote_ssh 'echo $HOME' 2>/dev/null) || {
    echo "WARNING: cannot reach remote $SSH_TARGET (port $SSH_PORT)" >&2
    write_sync_log "unreachable"
    exit 1
}

expand_remote_path() {
    case "$1" in
        "~"*) printf '%s\n' "${REMOTE_HOME}${1#\~}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

REMOTE_INDEX_ABS=$(expand_remote_path "$REMOTE_INDEX_DIR")

if ! remote_ssh "test -d '$REMOTE_INDEX_ABS'" 2>/dev/null; then
    echo "WARNING: remote index dir not accessible: $SSH_TARGET:$REMOTE_INDEX_ABS" >&2
    write_sync_log "unreachable"
    exit 1
fi

# -- Counters -------------------------------------------------------------------

SYNCED=0
SKIPPED=0
ERRORS=0

# -- Index file sync over SSH (newest-wins, no cmp needed - index files are --
# -- always fully regenerated by `csm reindex`, never hand-edited/appended) --

reconcile_index_pair() {
    local local_file="$1" remote_abs="$2" lmt="$3" rmt="$4" direction="$5"
    local rel; rel=$(basename "$local_file")

    if [ -n "$lmt" ] && [ -z "$rmt" ]; then
        if [ "$direction" = "pull" ]; then SKIPPED=$((SKIPPED + 1)); return; fi
        if $DRY_RUN; then echo "  PUSH $rel (exists locally, missing on remote)"; return; fi
        rsync -az -e "$RSYNC_RSH" "$local_file" "$SSH_TARGET:$remote_abs" 2>/dev/null \
            && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
        return
    fi
    if [ -z "$lmt" ] && [ -n "$rmt" ]; then
        if [ "$direction" = "push" ]; then SKIPPED=$((SKIPPED + 1)); return; fi
        if $DRY_RUN; then echo "  PULL $rel (exists on remote, missing locally)"; return; fi
        mkdir -p "$(dirname "$local_file")"
        rsync -az -e "$RSYNC_RSH" "$SSH_TARGET:$remote_abs" "$local_file" 2>/dev/null \
            && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
        return
    fi
    if [ -z "$lmt" ] && [ -z "$rmt" ]; then
        return  # neither exists
    fi

    # Both exist: newest wins
    if awk -v a="$lmt" -v b="$rmt" 'BEGIN{exit !(a>b)}'; then
        if [ "$direction" = "pull" ]; then SKIPPED=$((SKIPPED + 1)); return; fi
        if $DRY_RUN; then echo "  PUSH $rel (local → remote, local is newer)"; return; fi
        rsync -az -e "$RSYNC_RSH" "$local_file" "$SSH_TARGET:$remote_abs" 2>/dev/null \
            && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
    elif awk -v a="$rmt" -v b="$lmt" 'BEGIN{exit !(a>b)}'; then
        if [ "$direction" = "push" ]; then SKIPPED=$((SKIPPED + 1)); return; fi
        if $DRY_RUN; then echo "  PULL $rel (remote → local, remote is newer)"; return; fi
        rsync -az -e "$RSYNC_RSH" "$SSH_TARGET:$remote_abs" "$local_file" 2>/dev/null \
            && SYNCED=$((SYNCED + 1)) || ERRORS=$((ERRORS + 1))
    else
        SKIPPED=$((SKIPPED + 1))
    fi
}

# -- Local manifest: relpath<TAB>size<TAB>mtime, portable stat -----------------

local_manifest() {
    local root="$1"; shift
    find "$root" "$@" -type f 2>/dev/null | while IFS= read -r f; do
        local sz mt
        sz=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null || echo "")
        mt=$(stat -c%Y "$f" 2>/dev/null || stat -f%m "$f" 2>/dev/null || echo "")
        [ -z "$sz" ] || [ -z "$mt" ] && continue
        printf '%s\t%s\t%s\n' "${f#"$root"/}" "$sz" "$mt"
    done
}

# -- Sync one session's index entry by UUID ------------------------------------

sync_session() {
    local uuid="$1" direction="$2"

    local local_idx="$LOCAL_INDEX/${uuid}.json"
    local remote_idx_abs="$REMOTE_INDEX_ABS/${uuid}.json"
    local lmt="" rmt=""
    [ -f "$local_idx" ] && lmt=$(stat -c%Y "$local_idx" 2>/dev/null || stat -f%m "$local_idx" 2>/dev/null || echo "")
    local rstat
    rstat=$(remote_ssh "stat -c '%Y' '$remote_idx_abs' 2>/dev/null" 2>/dev/null || true)
    [ -n "$rstat" ] && rmt="$rstat"
    reconcile_index_pair "$local_idx" "$remote_idx_abs" "$lmt" "$rmt" "$direction"
}

# -- Sync the whole index dir: manifest diff + batched transfer ---------------

reconcile_dir() {
    local local_root="$1" remote_root="$2" direction="$3"
    local work; work=$(mktemp -d)

    local_manifest "$local_root" -maxdepth 1 -name '*.json' > "$work/local.tsv"
    remote_ssh "find '$remote_root' -maxdepth 1 -name '*.json' -printf '%P\t%s\t%T@\n' 2>/dev/null" > "$work/remote.tsv" 2>/dev/null || true

    python3 - "$work/local.tsv" "$work/remote.tsv" > "$work/plan.tsv" <<'PYEOF'
import sys

def load(path):
    d = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.rstrip("\n")
                if not line:
                    continue
                p, sz, mt = line.split("\t")
                d[p] = (int(float(sz)), float(mt))
    except FileNotFoundError:
        pass
    return d

local = load(sys.argv[1])
remote = load(sys.argv[2])

for p in sorted(set(local) | set(remote)):
    l, r = local.get(p), remote.get(p)
    if l and not r:
        print(f"PUSH\t{p}\t{l[0]}\t{l[1]}\t-\t-")
    elif r and not l:
        print(f"PULL\t{p}\t-\t-\t{r[0]}\t{r[1]}")
    else:
        lsz, lmt = l
        rsz, rmt = r
        if lsz == rsz and abs(lmt - rmt) < 2:
            print(f"SKIP\t{p}\t{lsz}\t{lmt}\t{rsz}\t{rmt}")
        else:
            print(f"CHECK\t{p}\t{lsz}\t{lmt}\t{rsz}\t{rmt}")
PYEOF

    local push_list="$work/push.txt" pull_list="$work/pull.txt"
    : > "$push_list"; : > "$pull_list"
    local total i=0
    total=$(wc -l < "$work/plan.tsv" | tr -d ' ')

    while IFS=$'\t' read -r action rel lsz lmt rsz rmt; do
        i=$((i + 1))
        case "$action" in
            SKIP)
                SKIPPED=$((SKIPPED + 1)) ;;
            PUSH)
                if [ "$direction" = "pull" ]; then
                    SKIPPED=$((SKIPPED + 1))
                elif $DRY_RUN; then
                    echo "  PUSH $rel"
                else
                    echo "$rel" >> "$push_list"
                fi ;;
            PULL)
                if [ "$direction" = "push" ]; then
                    SKIPPED=$((SKIPPED + 1))
                elif $DRY_RUN; then
                    echo "  PULL $rel"
                else
                    echo "$rel" >> "$pull_list"
                fi ;;
            CHECK)
                reconcile_index_pair "$local_root/$rel" "$remote_root/$rel" "$lmt" "$rmt" "$direction" ;;
        esac
        if [ $((i % 100)) -eq 0 ]; then
            echo -e "  ${GRAY}[$i/$total] processed...${RST}" >&2
        fi
    done < "$work/plan.tsv"

    if [ -s "$push_list" ]; then
        local n; n=$(wc -l < "$push_list" | tr -d ' ')
        if rsync -az -e "$RSYNC_RSH" --files-from="$push_list" "$local_root/" "$SSH_TARGET:$remote_root/" 2>/dev/null; then
            SYNCED=$((SYNCED + n))
        else
            ERRORS=$((ERRORS + n))
        fi
    fi
    if [ -s "$pull_list" ]; then
        local n; n=$(wc -l < "$pull_list" | tr -d ' ')
        mkdir -p "$local_root"
        if rsync -az -e "$RSYNC_RSH" --files-from="$pull_list" "$SSH_TARGET:$remote_root/" "$local_root/" 2>/dev/null; then
            SYNCED=$((SYNCED + n))
        else
            ERRORS=$((ERRORS + n))
        fi
    fi

    rm -rf "$work"
}

# -- Main ---------------------------------------------------------------------

if [ -n "$TARGET_UUID" ]; then
    sync_session "$TARGET_UUID" "$DIRECTION"
else
    echo "csm-sync: syncing $LOCAL_INDEX (LOCAL) ↔ $SSH_TARGET:$REMOTE_INDEX_ABS (REMOTE)"
    echo ""
    reconcile_dir "$LOCAL_INDEX" "$REMOTE_INDEX_ABS" "$DIRECTION"
fi

write_sync_log "success" "$SYNCED" "$ERRORS"

echo ""
if [ "$SYNCED" -gt 0 ] || [ "$ERRORS" -gt 0 ]; then
    echo "  Done: $SYNCED synced, $SKIPPED unchanged, $ERRORS errors"
else
    echo "  Done: all files up to date, $SKIPPED checked"
fi
