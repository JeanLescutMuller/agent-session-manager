# -- ANSI Colors ------------------------------------------------------------

RESET = "\033[0m"
C_DIR = "\033[38;5;240m"

# The host color carries exactly one bit: is this session on THIS machine
# (blue - genuinely resumable) or on another one (dark red - at best
# injectable)? A per-host hash palette used to live here and was dropped:
# with two or three real hosts it encoded nothing, and Python salts str
# hashes per process, so the same host changed color on every single run.
C_HOST_LOCAL = "\033[38;5;33m"    # blue      - this machine
C_HOST_REMOTE = "\033[38;5;88m"   # dark red  - some other machine
C_AGENT_CLAUDE = "\033[38;5;173m"  # terracotta - claude sessions
C_AGENT_CODEX = "\033[38;5;37m"    # teal       - codex sessions

C_FRESH = "\033[38;5;82m"      # bright green - active in the last 15 min
C_RECENT = "\033[38;5;148m"    # yellow-green - within the hour
C_HOURS = "\033[33m"           # yellow       - within 4 hours
C_HALFDAY = "\033[38;5;208m"   # orange       - within 12 hours
C_STALE = "\033[38;5;166m"     # dark orange  - pending but idle >12h
C_DELETED = "\033[38;5;52m"    # dark red     - source .jsonl is gone
C_INACTIVE = "\033[38;5;244m"  # grey         - exited, or state unknown

# Freshness ramp for a pending session's status block, freshest first:
# (max_minutes, color) - the first bucket the session fits into wins, and
# anything past the last bucket is C_STALE.
FRESHNESS_RAMP = ((15, C_FRESH), (60, C_RECENT), (240, C_HOURS), (720, C_HALFDAY))


