]


def _epilog_for(command: str) -> str:
    """Render this command's slice of EXAMPLES as a --help epilog."""
    rows = [(ex, note) for cmd, ex, note in EXAMPLES if cmd == command]
    width = max(len(ex) for ex, _ in rows)
    lines = ["Examples:"]
    for ex, note in rows:
        lines.append(f"  {ex.ljust(width)}   # {note}" if note else f"  {ex}")
    return "\n".join(lines)


TOP_DESCRIPTION = f"""asm {VERSION} - Agent Session Manager (local index)

  reindex → builds JSON index from local .jsonl files
  resume  → reads from local index (~/opt/agent-session-manager/data/indexes/) for fast I/O
  close   → reclaims RAM from a running session, leaves it resumable

'resume' and 'close' take identical search options - only the action on the
picked session differs: resume runs `claude --resume`/`codex resume`, close
terminates it. 'close' only supports Claude sessions for now - Codex has no
live-session surface yet, so it never appears in 'close's picker."""

TOP_EPILOG = "Run `asm <command> --help` for that command's full flag list and examples."


def _add_search_args(p: argparse.ArgumentParser) -> None:
    """Search/filter flags shared by 'resume' and 'close' - a single
    definition keeps their UX identical; they only diverge in what happens
    after a session is picked (see cmd_resume/cmd_close)."""
    p.add_argument("-f", "--from-days-ago", type=int, default=90, help="Only sessions active in last N days (default: 90)")
    p.add_argument("-u", "--until-days-ago", type=int, help="Only sessions active more than N days ago")
    p.add_argument("--host", default="", help="Filter by hostname")
    p.add_argument("--state", default="", help="Filter by session state (pending, exited, deleted)")
    p.add_argument("--agent", default="", help=f"Filter by agent type ({', '.join(sorted(BACKENDS))})")
    p.add_argument("--tmux", default="", help="Filter by tmux session name")
    p.add_argument("--max-scan", type=int, default=50, help="Max recent files to scan without keywords (default: 50)")
    p.add_argument("--uuid", default="", help="Skip the search, directly act on this session UUID")
    p.add_argument("-v", "--verbose", action="store_true", help="Enable verbose logging")
    p.add_argument("keywords", nargs="*", help="Keywords to search for")


def main() -> None:
    """Main entry point."""
    parser = argparse.ArgumentParser(
        prog="asm",
        description=TOP_DESCRIPTION,
        epilog=TOP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"asm {VERSION}")
    subparsers = parser.add_subparsers(dest="command")

    resume_parser = subparsers.add_parser(
        "resume", help="Find and resume a past session",
        epilog=_epilog_for("resume"), formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    _add_search_args(resume_parser)
    resume_parser.add_argument("--fork", action="store_true", help="Fork the session instead of resuming it")
    resume_parser.add_argument("--print-cmd", action="store_true",
                               help="Print the resume/fork command instead of running it (scripting/testing)")

    close_parser = subparsers.add_parser(
        "close", help="Find and close a running session (reclaims memory, leaves a resumable tombstone)",
        epilog=_epilog_for("close"), formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    _add_search_args(close_parser)

    reindex_parser = subparsers.add_parser(
        "reindex", help="Re-index all sessions now",
        epilog=_epilog_for("reindex"), formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    reindex_parser.add_argument("-n", "--max", type=int, default=0, help="Max sessions to process (0 = unlimited, default: 0)")
    reindex_parser.add_argument("--force", action="store_true", help="Force reindex all sessions, ignoring mtime-based skip")
    reindex_parser.add_argument("--uuid", default="", help="Reindex a single session by UUID")

    args = parser.parse_args()

    if not args.command:
        parser.print_help(sys.stderr)
        sys.exit(1)

    if args.command == "resume":
        cmd_resume(SearchOpts.from_args(args), args.fork, args.print_cmd)
    elif args.command == "close":
        cmd_close(SearchOpts.from_args(args))
    elif args.command == "reindex":
        cmd_reindex(args.max, args.force, args.uuid)


if __name__ == "__main__":
    main()
