def short_host(host: Optional[str]) -> Optional[str]:
    """Strip the DNS domain: 'mac.home' -> 'mac'. None/empty stays falsy.

    Hostnames reach the index from several places (lifecycle sidecars written
    by lifecycle_generation.sh, this process, indexes synced from another
    machine); comparing them only ever makes sense on the short form.
    """
    return host.split(".")[0] if host else None


