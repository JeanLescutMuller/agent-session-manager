# -- Utilities --------------------------------------------------------------

def log_verbose(msg: str, verbose: bool = False) -> None:
    """Print message to stderr with timestamp if verbose."""
    if verbose:
        ts = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")
        print(f"[{ts}] {msg}", file=sys.stderr)


def parse_ts(ts_str: Optional[str]) -> Optional[datetime]:
    """Parse an ISO 8601 '...Z' timestamp, or None if absent/unparseable.

    Every timestamp in the index and the sidecars is written in this one
    format, and half a dozen call sites used to each re-implement the
    .replace("Z", "+00:00") dance inside their own try/except.
    """
    if not ts_str:
        return None
    try:
        return datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
    except (ValueError, TypeError, AttributeError):
        return None


def _make_portable_jsonl_path(abs_path: str) -> str:
    """Convert absolute jsonl_path to portable ~/.claude/projects/... format.

    $HOME differs across machines (e.g. /Users/alice on a laptop vs
    /home/bob on a VM), and index files can be copied between machines
    by asm-sync. Normalizing to ~/.claude/projects/<slug>/<file> makes the
    path resolve correctly under whichever machine's $HOME reads it.
    """
    marker = "/.claude/projects/"
    idx = abs_path.find(marker)
    if idx != -1:
        return "~/.claude/projects/" + abs_path[idx + len(marker):]
    home = os.path.expanduser("~")
    if abs_path.startswith(home + "/"):
        return "~/" + abs_path[len(home) + 1:]
    return abs_path


def _resolve_jsonl_path(stored_path: str) -> str:
    """Resolve a stored jsonl_path (possibly with ~) to an absolute path."""
    if stored_path.startswith("~/"):
        return os.path.expanduser(stored_path)
    return stored_path


def read_json(path: str) -> Optional[Dict[str, Any]]:
    """Load one JSON file, or None if it is missing or malformed."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


# -- JSON Index Writer -----------------------------------------------------

def write_json_atomic(doc: Dict[str, Any], json_path: str) -> None:
    """Write JSON to temp file then rename (atomic on POSIX)."""
    Path(json_path).parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(Path(json_path).parent), suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(doc, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, json_path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# -- JSONL Parser -----------------------------------------------------------

# Transcript text arrives wrapped in bookkeeping tags - hook output, slash
# command plumbing, system reminders - that are noise both for keyword search
# and for the picker snippet. One alternation with a backreference strips them
# all in a single pass; adding a tag is a one-word edit to this tuple.
NOISE_TAGS = (
    "system-reminder", "local-command-caveat", "message", "task-notification",
    "command-name", "command-message", "command-args", "local-command-stdout",
    "role", "source_space", "instructions",
)
NOISE_RE = re.compile(r"<(" + "|".join(NOISE_TAGS) + r")\b[^>]*>.*?</\1>", re.DOTALL)


def iter_entries(jsonl_path: Any, warn: bool = False) -> Iterator[Dict[str, Any]]:
    """Yield one dict per line of a .jsonl file, skipping blank/malformed ones.

    Every reader in asm - transcripts and lifecycle sidecars alike - used to
    carry its own copy of this loop (open, strip, json.loads, swallow the
    decode error). A truncated final line is normal: Claude Code appends to
    these files live, so a session being written right now can be mid-line.
    """
    try:
        with open(jsonl_path, encoding="utf-8", errors="replace") as f:
            for raw in f:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    yield json.loads(raw)
                except json.JSONDecodeError:
                    continue
    except OSError as e:
        if warn:
            print(f"  WARNING: could not read {jsonl_path}: {e}", file=sys.stderr)


def extract_text(content: Any) -> str:
    """Flatten a message's content (str, or list of blocks) to clean text."""
    if isinstance(content, str):
        text = content
    elif isinstance(content, list):
        parts = [b.get("text", "") for b in content
                 if isinstance(b, dict) and b.get("type") == "text"]
        text = "\n".join(p for p in parts if p)
    else:
        return ""
    return NOISE_RE.sub("", text).strip()


def is_tool_result(entry: Dict[str, Any]) -> bool:
    """True for a user entry that is really a tool result, not a human turn."""
    content = entry.get("message", {}).get("content", "")
    if isinstance(content, list):
        return any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content)
    return False


class Transcript(NamedTuple):
    """Everything asm reads out of one .jsonl session transcript.

    Built by a single pass in read_transcript(). Indexing needs the messages,
    resume needs only the title and permission mode, but both used to walk
    the whole file with their own near-identical loop - and the title-priority
    rule had already drifted between the two copies.
    """
    session_id: str
    custom_title: Optional[str]     # set explicitly via /rename
    ai_title: Optional[str]         # Claude Code's own auto-generated title
    permission_mode: Optional[str]
    cwd: Optional[str]
    created_at: Optional[str]
    last_active: Optional[str]
    messages: List[Dict[str, Any]]

    @property
    def title(self) -> Optional[str]:
        """Best available title: an explicit /rename beats Claude's ai-title."""
        return self.custom_title or self.ai_title


def read_transcript(jsonl_path: str, warn: bool = True) -> Transcript:
    """Parse a session .jsonl into a Transcript (single pass over the file)."""
    session_id = custom_title = ai_title = permission_mode = None
    cwd = created_at = last_active = None
    messages: List[Dict[str, Any]] = []

    for entry in iter_entries(jsonl_path, warn=warn):
        etype = entry.get("type", "")

        if etype == "custom-title":
            custom_title = entry.get("customTitle") or custom_title
            session_id = entry.get("sessionId") or session_id
            continue

        if etype == "ai-title":
            ai_title = entry.get("aiTitle") or ai_title
            session_id = entry.get("sessionId") or session_id
            continue

        if not session_id:
            session_id = entry.get("sessionId")
        if not cwd:
            cwd = entry.get("cwd")

        if etype == "user" and entry.get("permissionMode"):
            permission_mode = entry["permissionMode"]

        # Only real conversation turns count as activity: a tool result is
        # bookkeeping, and an entry whose text is entirely noise tags is too.
        if etype == "assistant" or (etype == "user" and not is_tool_result(entry)):
            text = extract_text(entry.get("message", {}).get("content", ""))
            if text:
                ts = entry.get("timestamp")
                if created_at is None:
                    created_at = ts
                last_active = ts
                role = "assistant" if etype == "assistant" else "user"
                messages.append({"role": role, "timestamp": ts, "text": text})

    return Transcript(
        session_id=session_id or Path(jsonl_path).stem,
        custom_title=custom_title,
        ai_title=ai_title,
        permission_mode=permission_mode,
        cwd=cwd,
        created_at=created_at,
        last_active=last_active,
        messages=messages,
    )


# -- Codex backend: transcript parsing ---------------------------------------
# Codex's rollout .jsonl is shaped completely differently from Claude's: each
# line is {timestamp, type, payload}. The working directory comes straight off
# the first "session_meta" line's payload.cwd (no slug-decoding needed, unlike
# Claude). Titles aren't in the transcript at all - they live in a separate
# append-only log, ~/.codex/session_index.jsonl ({id, thread_name,
# updated_at}), latest line per id wins - so they're looked up separately and
# mapped onto Transcript.ai_title (Codex has no /rename-equivalent "custom"
# title source, so custom_title is always None for this backend).

_codex_titles_cache: Optional[Dict[str, str]] = None


def _codex_session_titles() -> Dict[str, str]:
    """uuid -> latest thread_name from ~/.codex/session_index.jsonl.

    Cached for the lifetime of the process: the file only grows during a
    reindex run, and re-reading it once per session would be O(sessions^2).
    """
    global _codex_titles_cache
    if _codex_titles_cache is None:
        titles: Dict[str, str] = {}
        for entry in iter_entries(CODEX_SESSION_INDEX_FILE):
            sid, name = entry.get("id"), entry.get("thread_name")
            if sid and name:
                titles[sid] = name
        _codex_titles_cache = titles
    return _codex_titles_cache


def read_codex_transcript(jsonl_path: str, warn: bool = True) -> Transcript:
    """Parse a Codex rollout .jsonl into a Transcript (single pass over the file)."""
    session_id = cwd = created_at = last_active = None
    messages: List[Dict[str, Any]] = []

    for entry in iter_entries(jsonl_path, warn=warn):
        etype = entry.get("type")
        payload = entry.get("payload") or {}

        if etype == "session_meta":
            session_id = payload.get("session_id") or payload.get("id") or session_id
            cwd = payload.get("cwd") or cwd
            continue

        if etype != "response_item" or payload.get("type") != "message":
            continue

        # "developer"-role entries are injected instructions (AGENTS.md, skill
        # text, mode reminders) - bookkeeping, not a conversation turn, exactly
        # like a Claude tool_result is excluded by is_tool_result() above.
        role = payload.get("role")
        if role not in ("user", "assistant"):
            continue

        content = payload.get("content")
        text = ""
        if isinstance(content, list):
            parts = [b.get("text", "") for b in content
                     if isinstance(b, dict) and b.get("type") in ("input_text", "output_text")]
            text = "\n".join(p for p in parts if p)
        text = NOISE_RE.sub("", text).strip()
        if text:
            ts = entry.get("timestamp")
            if created_at is None:
                created_at = ts
            last_active = ts
            messages.append({"role": role, "timestamp": ts, "text": text})

    return Transcript(
        session_id=session_id or Path(jsonl_path).stem,
        custom_title=None,
        ai_title=_codex_session_titles().get(session_id or ""),
        permission_mode=None,
        cwd=cwd,
        created_at=created_at,
        last_active=last_active,
        messages=messages,
    )


# -- Session Index Building -------------------------------------------------

def resolve_title(t: Transcript) -> Tuple[str, str]:
    """Pick the session's display title and record where it came from."""
    if t.custom_title:
        return t.custom_title, "custom"
    if t.ai_title:
        return t.ai_title, "ai"
    if not any(m["role"] == "user" and m["text"].strip() for m in t.messages):
        return "[Empty session]", "empty"
    return "Untitled session [prompt]", "untitled"


def determine_state(lifecycle_events: List[Dict[str, Any]]) -> str:
    """'pending' if the session is running, 'exited' otherwise.

    Compare the LATEST start/resume against the LATEST end, not just whether
    an end ever happened - a session that ended and was later resumed has an
    end event in its history forever, but is running right now. ISO 8601
    "...Z" timestamps sort correctly as strings.
    """
    start_times = [e.get("timestamp", "") for e in lifecycle_events
                   if e.get("event") in ("start", "resume")]
    if not start_times:
        return "exited"
    end_times = [e.get("timestamp", "") for e in lifecycle_events
                 if e.get("event") == "end"]
    if end_times and max(end_times) > max(start_times):
        return "exited"
    return "pending"


def build_doc(uuid: str, transcript: Transcript, lifecycle_events: List[Dict[str, Any]],
              jsonl_path: str, agent_type: str = "claude") -> Dict[str, Any]:
    """Build the index document for one session."""
    title, title_source = resolve_title(transcript)

    # The transcript's own cwd is authoritative; sidecars only fill the gap
    # for sessions that never recorded one.
    initial_working_dir = transcript.cwd
    if not initial_working_dir:
        initial_working_dir = next(
            (ev["working_dir"] for ev in lifecycle_events if ev.get("working_dir")), None)

    initial_hostname = latest_hostname = latest_working_dir = None
    tmux_session = tmux_window = tmux_pane = None
    for ev in lifecycle_events:
        if ev.get("event") == "start" and initial_hostname is None:
            initial_hostname = ev.get("hostname") or None
            tmux_session = ev.get("tmux_session") or None
            tmux_window = ev.get("tmux_window") or None
            tmux_pane = ev.get("tmux_pane") or None
        if ev.get("event") in ("start", "resume"):
            latest_hostname = ev.get("hostname") or latest_hostname
            latest_working_dir = ev.get("working_dir") or latest_working_dir

    return {
        "asm_version": VERSION,
        "agent_type": agent_type,
        "session_id": uuid,
        "custom_title": title,
        "title_source": title_source,
        "jsonl_path": _make_portable_jsonl_path(jsonl_path),
        "slug": Path(jsonl_path).parent.name,
        "initial_working_dir": initial_working_dir,
        "latest_working_dir": latest_working_dir,
        "initial_hostname": initial_hostname,
        "latest_hostname": latest_hostname,
        # Ground truth for "which machine was this session on": .jsonl files
        # are never synced between machines, so whoever indexes one is by
        # definition its host. Fills the gap for sessions with no lifecycle
        # sidecar (pre-hook ones), where the two fields above are null.
        "index_hostname": LOCAL_HOSTNAME or None,
        "created_at": transcript.created_at,
        "last_active": transcript.last_active,
        "session_state": determine_state(lifecycle_events),
        "tmux_session": tmux_session,
        "tmux_window": tmux_window,
        "tmux_pane": tmux_pane,
        "conversation": [
            {"role": m["role"], "timestamp": m["timestamp"], "text": m["text"]}
            for m in transcript.messages
        ],
    }


# -- Search options ---------------------------------------------------------

class SearchOpts(NamedTuple):
    """The filter/search flags shared by 'resume' and 'close'.

    These travel together through find_sessions and pick_session, so they move
    as one value rather than as seven positional arguments that the two
    commands had to keep in matching order by hand.
    """
    keywords: List[str]
    from_days: int = 90
    until_days: Optional[int] = None
    host: str = ""
    state: str = ""
    agent: str = ""
    tmux: str = ""
    max_scan: int = 50
    uuid: str = ""
    verbose: bool = False

    @classmethod
    def from_args(cls, args: argparse.Namespace) -> "SearchOpts":
        return cls(
            keywords=args.keywords,
            from_days=args.from_days_ago,
            until_days=args.until_days_ago,
            host=args.host,
            state=args.state,
            agent=args.agent,
            tmux=args.tmux,
            max_scan=args.max_scan,
            uuid=args.uuid,
            verbose=args.verbose,
        )


# -- Session Search ---------------------------------------------------------

def is_source_missing(d_fields: Dict[str, Any]) -> bool:
    """Check if the source .jsonl file has been deleted from disk."""
    jsonl_path = d_fields.get("jsonl_path", "")
    if not jsonl_path:
        return True
    return not os.path.exists(_resolve_jsonl_path(jsonl_path))


def load_index_doc(path: str) -> Optional[Dict[str, Any]]:
    """Read one index file and tag it with whether its .jsonl still exists."""
    doc = read_json(path)
    if doc is None:
        return None
    doc["_source_missing"] = is_source_missing(doc)
    return doc


def searchable_text(doc: Dict[str, Any]) -> str:
    """Text keywords are matched against: title, dirs, and the conversation.

    Deliberately excludes metadata (asm_version, hostnames, session_id), which
    would otherwise make every session match a keyword like the hostname.
    """
    parts = [str(doc[k]) for k in ("custom_title", "initial_working_dir", "latest_working_dir")
             if doc.get(k)]
    parts += [m["text"] for m in doc.get("conversation", []) if m.get("text")]
    return "\n".join(parts)


def passes_filters(doc: Dict[str, Any], opts: SearchOpts,
                   cutoff_from: Optional[datetime], cutoff_until: Optional[datetime]) -> bool:
    """Apply the --state / --host / --agent / --tmux / --from / --until filters to one session."""
    missing = doc.get("_source_missing", False)
    if opts.state:
        # 'deleted' is not a session_state in the index - it means the source
        # .jsonl is gone - so it is matched against _source_missing instead.
        if opts.state.lower() == "deleted":
            if not missing:
                return False
        elif missing or (doc.get("session_state") or "").lower() != opts.state.lower():
            return False

    if opts.host:
        hosts = [str(doc.get(k) or "") for k in
                 ("initial_hostname", "latest_hostname", "index_hostname")]
        if not any(opts.host.lower() in h.lower() for h in hosts):
            return False

    if opts.agent and (doc.get("agent_type") or "claude").lower() != opts.agent.lower():
        return False

    if opts.tmux:
        if opts.tmux.lower() not in (doc.get("tmux_session") or "").lower():
            return False

    ts = parse_ts(doc.get("last_active", ""))
    if ts:
        if cutoff_from and ts < cutoff_from:
            return False
        if cutoff_until and ts > cutoff_until:
            return False
    return True


def find_sessions(opts: SearchOpts) -> Tuple[List[Tuple[Dict[str, Any], str]], bool]:
    """Find matching sessions in the index.

    Returns ([(doc, idx_path), ...], fuzzy_flag). Exact substring matching is
    tried first; only if that finds nothing do we retry on 3-character
    prefixes, and flag the result as fuzzy so the caller can say so.
    """
    verbose = opts.verbose
    log_verbose("PHASE 1: Python search started", verbose)
    log_verbose(f"index_dir = {LOCAL_INDEX_DIR}", verbose)

    now = datetime.now(timezone.utc)
    cutoff_from = now - timedelta(days=opts.from_days) if opts.from_days > 0 else None
    cutoff_until = now - timedelta(days=int(opts.until_days)) if opts.until_days else None

    idx_files = glob.glob(os.path.join(LOCAL_INDEX_DIR, "*.json"))
    log_verbose(f"PHASE 2: Found {len(idx_files)} index files", verbose)

    # (doc, idx_path, searchable text) for everything surviving the filters
    candidates: List[Tuple[Dict[str, Any], str, str]] = []
    for idx_path in idx_files:
        doc = load_index_doc(idx_path)
        if doc is None:
            log_verbose(f"PHASE 2: ERROR reading {os.path.basename(idx_path)}", verbose)
            continue
        if passes_filters(doc, opts, cutoff_from, cutoff_until):
            candidates.append((doc, idx_path, searchable_text(doc)))

    # Sort by last_active (most recent first)
    candidates.sort(key=lambda item: item[0].get("last_active", "") or "", reverse=True)
    log_verbose(f"PHASE 3: {len(candidates)} sessions after filtering", verbose)

    # Apply max_scan limit (only when no keywords)
    if not opts.keywords:
        candidates = candidates[:opts.max_scan]

    def matches(text: str, fuzzy: bool = False) -> bool:
        lowered = text.lower()
        return all((kw[:3] if fuzzy else kw).lower() in lowered for kw in opts.keywords)

    fuzzy = False
    sessions = [(doc, path) for doc, path, text in candidates
                if not opts.keywords or matches(text)]

    if not sessions and opts.keywords:
        fuzzy = True
        log_verbose("PHASE 4: Trying fuzzy match...", verbose)
        sessions = [(doc, path) for doc, path, text in candidates if matches(text, fuzzy=True)]

    # Rank matched sessions. Title match is the strongest signal.
    # Within title-matching sessions, prefer most recent (stable sort preserves recency).
    # Within non-title-matching sessions, prefer higher TF density.
    if opts.keywords and sessions:
        text_by_path = {path: text for _, path, text in candidates}

        def rank_key(item: Tuple[Dict[str, Any], str]) -> Tuple[int, float]:
            doc, idx_path = item
            title = (doc.get("custom_title") or "").lower()
            if all(kw.lower() in title for kw in opts.keywords):
                return (0, 0.0)  # title match: stable sort keeps recency order
            text = text_by_path.get(idx_path, "")
            n_tokens = len(text.split()) or 1
            hits = sum(text.lower().count(kw.lower()) for kw in opts.keywords)
            return (1, -hits / n_tokens)

        sessions.sort(key=rank_key)

    log_verbose(f"PHASE 5: {len(sessions)} sessions matched (fuzzy={fuzzy})", verbose)
    return sessions, fuzzy


def find_by_uuid(uuid: str) -> Optional[Dict[str, Any]]:
    """Load one index doc by exact UUID, or by UUID prefix if no exact file
    exists. Used by --uuid to skip search/fzf entirely. None if 0 matches;
    exits with an error message (not just None) if the prefix is ambiguous,
    since silently picking one would be the wrong failure mode here."""
    exact = os.path.join(LOCAL_INDEX_DIR, f"{uuid}.json")
    if os.path.isfile(exact):
        return load_index_doc(exact)

    candidates = [p for p in glob.glob(os.path.join(LOCAL_INDEX_DIR, "*.json"))
                  if Path(p).stem.startswith(uuid)]
    if len(candidates) > 1:
        print(f"ERROR: multiple indexed sessions match uuid prefix '{uuid}':", file=sys.stderr)
        for p in candidates:
            print(f"  {Path(p).stem}", file=sys.stderr)
        sys.exit(1)
    return load_index_doc(candidates[0]) if candidates else None


# -- Session Display & Selection --------------------------------------------

def clean_field(v: Any) -> Optional[str]:
    """Normalize an index field to a real string, or None if it is a placeholder."""
    return None if (v is None or (s := str(v).strip()) in ("", "null", "?")) else s


def time_ago(ts_str: Optional[str]) -> str:
    """Compact fixed-width age: ' 5 min ago', ' 3 hou ago', or a date if older."""
    ts = parse_ts(ts_str)
    if ts is None:
        return " " * 10
    secs = max(0, int((datetime.now(timezone.utc) - ts).total_seconds()))
    if secs < 60:
        return f"{secs:2d} sec ago"
    mins = secs // 60
    if mins < 60:
        return f"{mins:2d} min ago"
    hours = mins // 60
    if hours < 24:
        return f"{hours:2d} hou ago"
    return ts.strftime("%Y-%m-%d")


def extract_snippet(conversation: List[Dict[str, Any]], keywords: Optional[List[str]] = None,
                    max_chars: int = 120) -> str:
    """One line of context for the picker's preview pane.

    With keywords, show the first message containing one, windowed around the
    hit so the match is visible. Without, show the opening user prompt.
    """
    for msg in conversation:
        text = msg.get("text", "").replace("\n", " ").strip()
        if not text:
            continue
        if not keywords:
            if msg.get("role") == "user":
                return text[:max_chars] + ("..." if len(text) > max_chars else "")
            continue
        hit = next((kw for kw in keywords if kw.lower() in text.lower()), None)
        if hit:
            idx = text.lower().find(hit.lower())
            start = max(0, idx - 40)
            snippet = text[start:start + max_chars].strip()
            if start > 0:
                snippet = "..." + snippet
            if start + max_chars < len(text):
                snippet += "..."
            return f"[{msg.get('role', '?')} {(msg.get('timestamp') or '')[:10]}] {snippet}"
    return ""


def status_block(doc: Dict[str, Any]) -> str:
    """The '[ Pending  5 min ago ]' prefix, colored by state and freshness."""
    state = clean_field(doc.get("session_state")) or "?"
    last_active = doc.get("last_active") or ""
    # A session with no lifecycle sidecar has no start/end events at all, so
    # its state was never observed - say "Unknown" rather than assert "Exited".
    has_lifecycle = bool(clean_field(doc.get("initial_hostname")))

    if doc.get("_source_missing", False):
        label, color = "Deleted", C_DELETED
    elif not has_lifecycle:
        label, color = "Unknown", C_INACTIVE
    elif state == "exited":
        label, color = "Exited", C_INACTIVE
    else:
        label = "Pending"
        ts = parse_ts(last_active)
        if ts is None:
            color = C_HALFDAY  # no usable timestamp: not fresh, but not ancient either
        else:
            mins = (datetime.now(timezone.utc) - ts).total_seconds() / 60
            color = next((c for limit, c in FRESHNESS_RAMP if mins < limit), C_STALE)

    return f"{color}[ {label:<7} {time_ago(last_active)} ]{RESET}"


def agent_block(doc: Dict[str, Any]) -> str:
    """Agent-type tag ('[claude]'/'[codex]'), always shown and color-coded so
    the two backends are visually distinguishable at a glance in a mixed
    picker."""
    agent = doc.get("agent_type") or "claude"
    color = C_AGENT_CLAUDE if agent == "claude" else C_AGENT_CODEX
    return f"{color}[{agent}]{RESET}"


def host_block(doc: Dict[str, Any]) -> str:
    """The hostname segment: 'mac' in blue if local, another host in dark red."""
    latest = short_host(clean_field(doc.get("latest_hostname")))
    initial = short_host(clean_field(doc.get("initial_hostname")))

    # Sessions predating the lifecycle hook have no sidecar and, until they get
    # reindexed, no index_hostname either - but if their .jsonl is still on this
    # disk they are ours, since .jsonl files are never synced between machines.
    host = latest or initial or short_host(clean_field(doc.get("index_hostname")))
    if not host and not doc.get("_source_missing", False):
        host = LOCAL_HOSTNAME
    if not host:
        return ""
    color = C_HOST_LOCAL if host == LOCAL_HOSTNAME else C_HOST_REMOTE
    return f"{color}{host}{RESET}"


def format_session_for_fzf(doc: Dict[str, Any], idx_path: str,
                           keywords: Optional[List[str]]) -> str:
    """One fzf row: visible columns, then tab-separated fields for the preview.

    Layout is 'display \t snippet \t title-source \t uuid'; fzf shows only
    field 1 (--with-nth=1) and the preview command reads fields 2 and 3.
    """
    uuid = doc.get("session_id", os.path.basename(idx_path).replace(".json", ""))
    title = clean_field(doc.get("custom_title")) or uuid
    working_dir = clean_field(doc.get("latest_working_dir")) or clean_field(doc.get("initial_working_dir"))

    source = doc.get("title_source")
    marker = TITLE_SOURCE_MARKERS.get(source, "")
    title_str = f"\033[97m{marker + ' ' if marker else ''}{title}{RESET}"
    source_label = f"Title: {TITLE_SOURCE_LABELS[source]}" if source in TITLE_SOURCE_LABELS else ""

    columns = [status_block(doc), title_str, agent_block(doc), host_block(doc)]
    if working_dir:
        columns.append(f"{C_DIR}{working_dir}{RESET}")
    display = "  ".join(c for c in columns if c)

    snippet = extract_snippet(doc.get("conversation", []), keywords)
    return f"{display}\t{snippet}\t{source_label}\t{uuid}"


def run_fzf(sessions: List[Tuple[Dict[str, Any], str]], keywords: Optional[List[str]],
            verbose: bool = False,
            action_verb: str = "Resume") -> Tuple[Optional[str], Optional[Dict[str, Any]]]:
    """Run fzf picker and return (UUID, doc) tuple. Returns (None, None) if cancelled."""
    if not sessions:
        print("No sessions found.", file=sys.stderr)
        return None, None

    docs_by_uuid = {doc["session_id"]: doc for doc, _ in sessions if doc.get("session_id")}
    fzf_input = "".join(format_session_for_fzf(doc, path, keywords) + "\n"
                        for doc, path in sessions)

    # Preview shows the title-source label (field 3) above the snippet (field 2),
    # with the search terms highlighted in the snippet when there are any.
    preview_cmd = 'printf "%s\\n%s\\n" {3} {2}'
    if keywords:
        kw_pat = "|".join(keywords)
        preview_cmd = (f"printf '%s\\n' {{3}}; printf '%s\\n' {{2}} | "
                       f"GREP_COLOR='1;31' GREP_COLORS='ms=1;31' grep -iE --color=always '{kw_pat}|$'")

    try:
        result = subprocess.run(
            [
                "fzf",
                "--ansi",
                "--delimiter=\t",
                "--with-nth=1",
                "--preview", preview_cmd,
                "--preview-window=down:3:wrap",
                f"--prompt=[{VERSION}] {action_verb} session: ",
                "--height=80%",
                "--layout=reverse",
                "--no-multi",
            ],
            input=fzf_input,
            capture_output=True,
            text=True,
        )

        if result.returncode != 0:
            print("Cancelled.", file=sys.stderr)
            return None, None

        selected = result.stdout.strip()
        if not selected:
            print("No session selected.", file=sys.stderr)
            return None, None

        uuid = selected.split("\t")[-1]
        log_verbose(f"UUID selected: {uuid}", verbose)
        return uuid, docs_by_uuid.get(uuid)

    except FileNotFoundError:
        print("ERROR: fzf not found. Install it with: brew install fzf", file=sys.stderr)
        return None, None


# -- Slug Decoding ---------------------------------------------------------

def decode_slug_to_path(slug: str, verbose: bool = False) -> Optional[str]:
    """Decode a project folder slug back to a filesystem path.

    Claude Code encodes paths by replacing /, _, and . with -.
    Since this is lossy, we probe the filesystem to resolve ambiguity:
    at each - in the slug, try /, _, ., and literal -, checking which
    path components actually exist as directories on disk.

    Returns the decoded path if a valid directory is found, else None.
    """
    if not slug or slug[0] != '-':
        return None

    raw = slug[1:]  # strip leading - (represents /)
    if not raw:
        return "/"

    dir_cache: Dict[str, bool] = {}
    children_cache: Dict[str, List[str]] = {}

    def isdir(p: str) -> bool:
        if p not in dir_cache:
            dir_cache[p] = os.path.isdir(p)
        return dir_cache[p]

    def get_children(d: str) -> List[str]:
        if d not in children_cache:
            try:
                children_cache[d] = os.listdir(d)
            except OSError:
                children_cache[d] = []
        return children_cache[d]

    def recurse(pos: int, current_path: str, component: str) -> Optional[str]:
        if pos >= len(raw):
            if component:
                full = os.path.join(current_path, component)
                return full if isdir(full) else None
            return current_path if isdir(current_path) else None

        ch = raw[pos]

        if ch != '-':
            return recurse(pos + 1, current_path, component + ch)

        # ch is '-': was originally /, _, ., or literal -
        if component:
            # Prune: if no entry in current_path starts with component, stop
            if not any(c.startswith(component) for c in get_children(current_path)):
                return None

            # Try / first (most common): end component, descend into directory
            candidate = os.path.join(current_path, component)
            if isdir(candidate):
                result = recurse(pos + 1, candidate, "")
                if result:
                    return result

            # Then _, then ., then a literal - kept as part of the component
            for suffix in ("_", ".", "-"):
                result = recurse(pos + 1, current_path, component + suffix)
                if result:
                    return result
        else:
            # Right after a / (no component yet)
            # Could be start of a dotfile (e.g., /.config encoded as --config)
            for prefix in (".", "_", "-"):
                result = recurse(pos + 1, current_path, prefix)
                if result:
                    return result

        return None

    result = recurse(0, "/", "")
    log_verbose(f"decode_slug_to_path({slug!r}) -> {result!r}", verbose)
    return result


# -- Working Directory Resolution -------------------------------------------

def resolve_working_dir(slug: str, verbose: bool = False) -> Optional[str]:
    """Resolve a session's slug to the local working directory for resume.

    Claude --resume requires cd-ing into the directory whose encoded slug
    matches the folder where the .jsonl lives. This function decodes the
    slug back to a filesystem path by probing the filesystem.

    For cross-machine resume, it also checks alias slugs in ~/.claude/projects/
    that resolve to the same real directory (via symlinks).
    """
    log_verbose("=== WORKING DIR RESOLUTION ===", verbose)
    log_verbose(f"slug: {slug}", verbose)

    # 1. Try to decode the slug directly (same-machine case)
    path = decode_slug_to_path(slug, verbose)
    if path and os.path.isdir(path):
        log_verbose(f"Direct decode succeeded: {path}", verbose)
        return path

    # 2. If direct decode failed, try alias slugs that resolve to the same dir
    slug_path = os.path.join(PROJECTS_DIR, slug)
    if not os.path.exists(slug_path):
        log_verbose(f"Slug folder does not exist in projects: {slug_path}", verbose)
        return None

    target_real = os.path.realpath(slug_path)
    log_verbose(f"Slug realpath: {target_real}", verbose)
    log_verbose(f"Scanning alias slugs in {PROJECTS_DIR}", verbose)

    for name in sorted(os.listdir(PROJECTS_DIR)):
        if name == slug:
            continue
        entry = os.path.join(PROJECTS_DIR, name)
        if not os.path.exists(entry) or os.path.realpath(entry) != target_real:
            continue

        log_verbose(f"  Alias slug {name} resolves to same dir", verbose)
        path = decode_slug_to_path(name, verbose)
        if path and os.path.isdir(path):
            log_verbose(f"  Alias decode succeeded: {path}", verbose)
            return path

    log_verbose("No valid working dir found", verbose)
    log_verbose("=== END WORKING DIR RESOLUTION ===", verbose)
    return None


# -- Claude backend adapters --------------------------------------------------
# Thin doc-shaped wrappers around the two functions above, so they fit the
# Backend interface (see "Agent backends" below) without changing their own
# slug-based signatures, which nothing else needs to know about.

def _claude_resolve_working_dir(doc: Dict[str, Any], verbose: bool = False) -> Optional[str]:
    return resolve_working_dir(doc.get("slug", ""), verbose)


def _claude_resume_cmd(doc: Dict[str, Any], transcript: Optional["Transcript"],
                       working_dir: str, uuid: str, fork: bool) -> str:
    """Build the `claude --resume` shell command (same logic cmd_resume always used)."""
    perm_mode = transcript.permission_mode if transcript else None
    title = (transcript.title if transcript else None) or doc.get("custom_title", "")
    claude_flags = "--dangerously-skip-permissions " if perm_mode == "bypassPermissions" else ""
    cmd = (f"cd {subprocess.list2cmdline([working_dir])} && "
           f"claude {claude_flags}--resume {subprocess.list2cmdline([uuid])}")
    if fork:
        cmd += " --fork-session"
    if title:
        clean_title = re.sub(r'\s*\[prompt\]\s*$', '', title)
        cmd += f" {shlex.quote('/rename ' + clean_title)}"
    return cmd


def _claude_uuid_of(jsonl_path: str) -> str:
    """Claude names transcripts <uuid>.jsonl directly - the stem is the uuid."""
    return Path(jsonl_path).stem


# -- Codex backend adapters ---------------------------------------------------

def _codex_resolve_working_dir(doc: Dict[str, Any], verbose: bool = False) -> Optional[str]:
    """Codex records an absolute cwd directly in the transcript (build_doc
    already copies it into these fields) - no slug-decoding needed."""
    return doc.get("latest_working_dir") or doc.get("initial_working_dir")


def _codex_resume_cmd(doc: Dict[str, Any], transcript: Optional["Transcript"],
                      working_dir: str, uuid: str, fork: bool) -> str:
    """Build the `codex resume`/`codex fork` shell command."""
    action = "fork" if fork else "resume"
    return f"cd {subprocess.list2cmdline([working_dir])} && codex {action} {subprocess.list2cmdline([uuid])}"


# Codex names transcripts rollout-<timestamp>-<uuid>.jsonl - the uuid is
# always the last 36 characters before the extension.
_CODEX_UUID_RE = re.compile(
    r'-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$')


def _codex_uuid_of(jsonl_path: str) -> str:
    m = _CODEX_UUID_RE.search(jsonl_path)
    return m.group(1) if m else Path(jsonl_path).stem


def scan_codex_sessions() -> Dict[str, float]:
    """Scan all local Codex rollout .jsonl files. Returns {path: mtime}.

    Codex shards sessions by date (~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl)
    rather than Claude's per-project-slug layout, hence the recursive walk.
    """
    d: Dict[str, float] = {}
    root = Path(CODEX_SESSIONS_DIR)
    if not root.exists():
        return d
    for f in root.rglob("*.jsonl"):
        if f.is_file():
            d[str(f)] = f.stat().st_mtime
    return d


# -- Indexing Operations ----------------------------------------------------

def scan_history_jsonl() -> Dict[str, float]:
    """Scan all local .jsonl history files. Returns {path: mtime}."""
    d: Dict[str, float] = {}
    projects_dir = Path(PROJECTS_DIR)
    if not projects_dir.exists():
        return d
    for slug_dir in projects_dir.iterdir():
        if not slug_dir.is_dir():
            continue
        try:
            for f in slug_dir.iterdir():
                # agent-*.jsonl are subagent transcripts, not resumable sessions
                if f.is_file() and f.suffix == ".jsonl" and not f.name.startswith("agent-"):
                    d[str(f)] = f.stat().st_mtime
        except OSError:
            continue
    return d


def scan_index_dir(index_dir: str) -> Dict[str, float]:
    """Scan a flat directory of .json index files. Returns {path: mtime}."""
    d: Dict[str, float] = {}
    idx_dir = Path(index_dir)
    if not idx_dir.exists():
        return d
    for f in idx_dir.iterdir():
        if f.is_file() and f.name.endswith(".json"):
            d[str(f)] = f.stat().st_mtime
    return d


def is_ignored_session(jsonl_path: str) -> bool:
    """True if jsonl_path matches any configured ignore_path_substrings entry.

    Lets users exclude sessions from specific tools/directories (e.g. an
    automated agent's own working space) without a code change - configure
    `ignore_path_substrings` in ~/opt/agent-session-manager/data/settings.json."""
    return any(s in jsonl_path for s in IGNORE_PATH_SUBSTRINGS)


# -- Agent backends ----------------------------------------------------------
# The seam between "how to find/parse/resolve/resume a session for this
# agent" (agent-specific) and everything else - search, filtering, ranking,
# fzf display, host coloring - which already operates purely on index-doc
# dicts and doesn't care where they came from.

class Backend(NamedTuple):
    name: str
    scan: Callable[[], Dict[str, float]]                                  # () -> {jsonl_path: mtime}
    parse: Callable[..., "Transcript"]                                    # (jsonl_path, warn=...) -> Transcript
    resolve_working_dir: Callable[[Dict[str, Any], bool], Optional[str]]  # (doc, verbose) -> path
    resume_cmd: Callable[[Dict[str, Any], Optional["Transcript"], str, str, bool], str]
    uuid_of: Callable[[str], str]                                        # jsonl_path -> uuid
    supports_close: bool


def index_one(backend: Backend, jsonl_path: str, idx_path: str) -> Tuple[str, str]:
    """Index a single session with the given backend. Returns (title, source).
    source is "custom" (via /rename), "ai" (native ai-title),
    "empty" (no messages), or "untitled" (has messages but no title)."""
    uuid = backend.uuid_of(jsonl_path)
    transcript = backend.parse(jsonl_path)
    lifecycle_events = list(iter_entries(Path(LIFECYCLE_DIR) / f"{uuid}.jsonl"))

    doc = build_doc(uuid, transcript, lifecycle_events, jsonl_path, backend.name)
    write_json_atomic(doc, idx_path)

    return doc["custom_title"], doc["title_source"]


def needs_reindex(uuid: str, jsonl_mtime: float, idx_mtime: Optional[float]) -> bool:
    """True unless both the transcript and its sidecar predate the index file.

    The sidecar has to be checked separately: a session that only started or
    ended since the last run has a fresh lifecycle event but an untouched
    .jsonl, and its state in the index would otherwise never update.
    """
    if idx_mtime is None or jsonl_mtime > idx_mtime:
        return True
    lifecycle_path = Path(LIFECYCLE_DIR) / f"{uuid}.jsonl"
    return lifecycle_path.exists() and lifecycle_path.stat().st_mtime > idx_mtime


BACKENDS: Dict[str, Backend] = {
    "claude": Backend(
        name="claude",
        scan=scan_history_jsonl,
        parse=read_transcript,
        resolve_working_dir=_claude_resolve_working_dir,
        resume_cmd=_claude_resume_cmd,
        uuid_of=_claude_uuid_of,
        supports_close=True,
    ),
}

if CODEX_ENABLED:
    BACKENDS["codex"] = Backend(
