        scan=scan_codex_sessions,
        parse=read_codex_transcript,
        resolve_working_dir=_codex_resolve_working_dir,
        resume_cmd=_codex_resume_cmd,
        uuid_of=_codex_uuid_of,
        supports_close=False,  # no stable live-session surface yet, see DEV_DOC.md
    )


# -- Commands ---------------------------------------------------------------

def cmd_reindex(max_sessions: int = 0, force: bool = False, single_uuid: str = "") -> Dict[str, int]:
    """Build/refresh index JSON files from local JSONL files.

    Step 1: Scan local .jsonl history files → d_history
    Step 2: Scan local .json index files → d_index
    Step 3: Decide what to reindex + reindex
    """
    mode = "force-reindex" if force else "reindex"
    if single_uuid:
        mode = f"reindex --uuid {single_uuid[:8]}"
    print(f"asm {VERSION} - {mode}" + (f" (max {max_sessions})" if max_sessions else ""), flush=True)

    Path(LOCAL_INDEX_DIR).mkdir(parents=True, exist_ok=True)

    # -- Step 1: Scan local .jsonl history files, across all backends -
    d_history: Dict[str, Tuple[float, Backend]] = {}
    for backend in BACKENDS.values():
        for p, m in backend.scan().items():
            d_history[p] = (m, backend)
    if single_uuid:
        d_history = {p: v for p, v in d_history.items() if v[1].uuid_of(p) == single_uuid}
    print(f"  Step 1: {len(d_history)} .jsonl history files found", flush=True)

    # -- Step 2: Scan local .json index files -------------------------
    d_index = scan_index_dir(LOCAL_INDEX_DIR)
    print(f"  Step 2: {len(d_index)} .json index files in local cache", flush=True)

    idx_mtime_by_uuid = {Path(p).stem: mtime for p, mtime in d_index.items()}

    # -- Step 3a: Decide what needs reindexing ------------------------
    to_reindex: List[Tuple[str, str, Backend]] = []  # [(jsonl_path, idx_path, backend), ...]
    skipped = ignored = duplicates = 0
    seen_uuids: set = set()

    for jsonl_path, (jsonl_mtime, backend) in d_history.items():
        if max_sessions and len(seen_uuids) >= max_sessions:
            break
        uuid = backend.uuid_of(jsonl_path)
        if uuid in seen_uuids:
            duplicates += 1
            continue
        seen_uuids.add(uuid)

        if is_ignored_session(jsonl_path):
            ignored += 1
            continue

        if not force and not needs_reindex(uuid, jsonl_mtime, idx_mtime_by_uuid.get(uuid)):
            skipped += 1
            continue

        to_reindex.append((jsonl_path, os.path.join(LOCAL_INDEX_DIR, f"{uuid}.json"), backend))

    total_scanned = len(seen_uuids)
    n_to_reindex = len(to_reindex)
    print(f"  Step 3a: {total_scanned} sessions scanned, {n_to_reindex} to reindex, "
          f"{skipped} up to date, {ignored} ignored, {duplicates} duplicates", flush=True)

    # -- Step 3b: Reindex in parallel with [i/N] progress ------------
    indexed = errors = 0
    counter_lock = threading.Lock()
    done = 0

    def report(uuid: str, exc: Optional[Exception], title: str, source: str) -> None:
        """Print one [i/N] progress line. Called from the main thread only."""
        nonlocal indexed, errors, done
        done += 1
        if exc is None:
            indexed += 1
            marker = TITLE_SOURCE_MARKERS.get(source, "⚠️")
            print(f"    [{done}/{n_to_reindex}] {uuid[:8]}  indexed {marker} {title[:60]}", flush=True)
        else:
            errors += 1
            print(f"    [{done}/{n_to_reindex}] {uuid[:8]}  ERROR: {exc}", file=sys.stderr, flush=True)

    def worker(jsonl_path: str, idx_path: str, backend: Backend) -> Tuple[str, Optional[Exception], str, str]:
        uuid = backend.uuid_of(jsonl_path)
        try:
            title, source = index_one(backend, jsonl_path, idx_path)
            return (uuid, None, title, source)
        except Exception as e:
            return (uuid, e, "", "")

    max_workers = min(10, n_to_reindex) if n_to_reindex > 0 else 1
    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = [executor.submit(worker, jp, ip, b) for jp, ip, b in to_reindex]
        for future in as_completed(futures):
            with counter_lock:
                report(*future.result())

    print(f"  Step 3b: indexed={indexed}, errors={errors}")

    return {"sessions_scanned": total_scanned, "sessions_indexed": indexed,
            "sessions_skipped": skipped, "errors": errors}


# -- Sync awareness ---------------------------------------------------------

def _read_sync_log_tail(max_lines: int = 200) -> List[Dict[str, Any]]:
    """Read up to the last max_lines entries from ~/opt/agent-session-manager/data/sync-log.jsonl.

    Slices the raw lines before parsing: the log gains an entry per sync
    attempt forever, and only the tail is ever of interest.
    """
    try:
        with open(SYNC_LOG_PATH, encoding="utf-8", errors="replace") as f:
            lines = f.readlines()[-max_lines:]
    except OSError:
        return []
    entries = []
    for line in lines:
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return entries


def _maybe_pull_before_resume(verbose: bool = False) -> None:
    """Opportunistic, rate-limited pull of the remote index before searching.

    Never blocks more than a few seconds and never raises - a failed or timed
    out pull just means asm resume searches whatever's already local."""
    entries = _read_sync_log_tail()
    if entries:
        last_attempt = parse_ts(entries[-1].get("timestamp"))
        if last_attempt and (datetime.now(timezone.utc) - last_attempt).total_seconds() < 60:
            log_verbose("Skipping opportunistic pull (attempted <60s ago)", verbose)
            return
    try:
        subprocess.run(
            ["asm-sync", "--pull"], timeout=5, capture_output=True,
            stdin=subprocess.DEVNULL,
        )
    except Exception as e:
        log_verbose(f"Opportunistic pull skipped: {e}", verbose)


def _sync_staleness_warning() -> Optional[str]:
    """Return a warning string if the last successful sync is stale/missing, else None."""
    last_success = next(
        (parse_ts(e.get("timestamp")) for e in reversed(_read_sync_log_tail())
         if e.get("outcome") == "success"), None)
    if last_success is None:
        return "never synced with remote yet"
    age_hours = (datetime.now(timezone.utc) - last_success).total_seconds() / 3600
    if age_hours <= SYNC_STALE_WARNING_HOURS:
        return None
    if age_hours >= 48:
        return f"last synced with remote {age_hours / 24:.0f}d ago"
    return f"last synced with remote {age_hours:.0f}h ago"


# -- Picking a session (shared by resume and close) --------------------------

def pick_session(opts: SearchOpts, action_verb: str,
                 live_only: bool = False) -> Tuple[str, Dict[str, Any]]:
    """Search the index and let the user pick one session in fzf.

    This is the entire front half of both `asm resume` and `asm close` - they
    are deliberately the same UX and the same flags, and diverge only in what
    they then do with the session that comes back. Exits the process on an
    empty result or a cancelled picker; never returns None.
    """
    if not os.path.isdir(LOCAL_INDEX_DIR):
        print(f"ERROR: local index cache not found at {LOCAL_INDEX_DIR}", file=sys.stderr)
        print("  Run 'asm reindex' first to build the local cache.", file=sys.stderr)
        sys.exit(1)

    if _SETTINGS.get("remote_ssh_host", ""):
        _maybe_pull_before_resume(opts.verbose)
        warning = _sync_staleness_warning()
        if warning:
            print(f"\033[38;5;208m⚠ {warning}\033[0m", file=sys.stderr)

    sessions, fuzzy = find_sessions(opts)
    if fuzzy:
        print("  (no exact matches - showing fuzzy results)", file=sys.stderr)

    if live_only:
        # find_sessions draws from the full index - years of exited history,
        # plus entries synced from another machine - none of which close can
        # do anything with. Scope it down to what is actually running here.
        live_ids = _live_session_ids()
        sessions = [(doc, path) for doc, path in sessions if doc.get("session_id") in live_ids]
        if not sessions:
            scope = f" matching '{' '.join(opts.keywords)}'" if opts.keywords else ""
            print(f"No running sessions{scope} to close.", file=sys.stderr)
            sys.exit(0)

    uuid, doc = run_fzf(sessions, opts.keywords, opts.verbose, action_verb)
    if not uuid or not doc:
        sys.exit(0)
    return uuid, doc


# -- Resume -----------------------------------------------------------------

def cmd_resume(opts: SearchOpts, fork: bool = False, print_cmd: bool = False) -> None:
    """Find and resume a session.

    print_cmd builds the exact command and prints it to stdout (nothing else)
    instead of exec'ing it - a scriptable, non-interactive seam for tests that
    need to assert on resume/fork command construction without ever launching
    either agent's TUI.
    """
    if opts.uuid:
        doc = find_by_uuid(opts.uuid)
        if not doc:
            print(f"ERROR: no indexed session matches uuid '{opts.uuid}'.", file=sys.stderr)
            sys.exit(1)
        uuid = doc.get("session_id", opts.uuid)
    else:
        uuid, doc = pick_session(opts, action_verb="Resume")

    if doc.get("_source_missing", False):
        if print_cmd:
            print(f"ERROR: session {uuid} not found locally, cannot build a resume command.",
                  file=sys.stderr)
            sys.exit(1)
        # The .jsonl itself is gone - either deleted locally, or this doc came
        # from a machine that has never synced .jsonl files (asm-sync only ever
        # moves the index, never the transcript), so a real resume is not
        # possible either way. /inject reads the indexed conversation straight
        # into a new session instead.
        print("\n\033[38;5;208mSession not found locally.\033[0m")
        print(f"  UUID:  {uuid}")
        print(f"  Title: {doc.get('custom_title', '')}")
        print(f"  Slug:  {doc.get('slug', '')}")
        print(f"\n  True resume is not possible: the .jsonl transcript isn't on this machine.")
        print(f"  Open Claude and run: /inject {uuid}")
        sys.exit(0)

    backend = BACKENDS.get(doc.get("agent_type") or "claude", BACKENDS["claude"])
    slug = doc.get("slug", "")
    initial_wd = doc.get("initial_working_dir", "")
    latest_wd = doc.get("latest_working_dir", "")

    # Re-read the transcript: it holds the permission mode, and a title that
    # may be newer than the indexed one if the session was renamed since.
    jsonl_path = _resolve_jsonl_path(doc.get("jsonl_path", ""))
    transcript = backend.parse(jsonl_path, warn=False) if jsonl_path else None
    perm_mode = transcript.permission_mode if transcript else None
    title = (transcript.title if transcript else None) or doc.get("custom_title", "")

    working_dir = backend.resolve_working_dir(doc, opts.verbose)

    if not print_cmd:
        # -- Session info (same format used by /info skill) --
        print("")
        print(f"Title:              {title or '(not set)'}")
        print(f"UUID:               {uuid}")
        print(f"Original WD:        {initial_wd}")
        print(f"Latest WD:          {latest_wd or initial_wd}")
        print(f"JSONL file:         {jsonl_path or '(unknown)'}")
        print(f"Permission mode:    {perm_mode or '(unknown)'}")
        print(f"Selected local dir: {working_dir or '(none)'}")

    if not (working_dir and os.path.isdir(working_dir)):
        if print_cmd:
            print(f"ERROR: no accessible working directory for session {uuid}.", file=sys.stderr)
            sys.exit(1)
        print("Command:            (cannot resume, directory not found)")
        print("")
        print(f"\033[33mWARNING: no accessible directory found for slug: {slug}\033[0m")
        print(f"  Original dir: {initial_wd}")
        print("")
        print("True resume is not possible from here.")
        print(f"Open Claude and run: /inject {uuid}")
        print("")
        return

    cmd = backend.resume_cmd(doc, transcript, working_dir, uuid, fork)

    if print_cmd:
        print(cmd)
        return

    print(f"Command:            {cmd}")
    print("")
    print(f"{'Forking' if fork else 'Resuming'} in {working_dir} ...")
    os.execv("/bin/bash", ["/bin/bash", "-c", cmd])


# -- Close (reclaim RAM from a running session) ------------------------------
#
# Search/pick is identical to resume (both call pick_session) - the two
# commands only differ from here on: instead of building a `claude --resume`
# command, this captures the tmux pane, SIGTERMs the process (never SIGKILL,
# so it flushes its transcript), and writes a tombstone + pre-typed resume
# command into the pane so it survives the alt-screen teardown on exit.
# Ported from the bash prototype src/asm-close after it was validated live.
#
# Unlike resume/reindex, there's no dry-run/--yes gate here: reaching this
# code via --uuid or an fzf pick already *is* the deliberate act. The safety
# checks below are correctness guards (never close yourself, a busy session,
# a non-tmux session, a stale pid/pane), not "are you sure" friction.

def _rss_mb(pid: int) -> Optional[int]:
    """Current RSS in MB, or None if the process is gone."""
    try:
        out = subprocess.run(["ps", "-o", "rss=", "-p", str(pid)],
                             capture_output=True, text=True).stdout.strip()
        return int(out) // 1024 if out else None
    except (subprocess.SubprocessError, ValueError):
        return None


def _human_age(age_ms: int) -> str:
    """Idle time as '7m', '3h20m' or '2d13h'."""
    mins = max(0, age_ms) // 60000
    if mins < 60:
        return f"{mins}m"
    if mins < 1440:
        return f"{mins // 60}h{mins % 60}m"
    return f"{mins // 1440}d{(mins % 1440) // 60}h"


def _live_sessions() -> List[Dict[str, Any]]:
    """Every currently-running local Claude Code session.

    Claude Code publishes one ~/.claude/sessions/<pid>.json per live process,
    holding its uuid, status, tmux pane and name. This is the only source that
    knows what is running *now* - the asm index deliberately spans all of
    history, including sessions that exited months ago or live on another host.
    """
    sessions = []
    for path in glob.glob(os.path.join(LIVE_SESSIONS_DIR, "*.json")):
        doc = read_json(path)
        if doc and doc.get("sessionId"):
            sessions.append(doc)
    return sessions


def _live_session_ids() -> set:
    """UUIDs of all currently-running local sessions - i.e. what close can act on."""
    return {s["sessionId"] for s in _live_sessions()}


def _find_live_session(uuid: str) -> Optional[Dict[str, Any]]:
    """Return the live session matching uuid (exact, or prefix if unambiguous).
    None if there's no live process for it - already exited, or from another
    machine. Exits on an ambiguous prefix rather than guessing."""
    matches = [s for s in _live_sessions()
               if s["sessionId"] == uuid or (uuid and s["sessionId"].startswith(uuid))]
    if len(matches) > 1:
        print(f"ERROR: multiple live sessions match uuid '{uuid}':", file=sys.stderr)
        for s in matches:
            print(f"  {s.get('pid')}  {s.get('name')}  {s.get('sessionId')}", file=sys.stderr)
        sys.exit(1)
    return matches[0] if matches else None


def _die(msg: str) -> None:
    """Report a failed safety check and stop - nothing has been touched yet."""
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def _check_closeable(live: Dict[str, Any]) -> str:
    """Run every safety check against a live session, returning its tmux pane.

    Ordered cheapest-first, and all of them run before anything is captured or
    signalled, so a refusal always leaves the session exactly as it was.
    """
    pid, session_id = live.get("pid"), live["sessionId"]

    if os.environ.get("CLAUDE_CODE_SESSION_ID") == session_id:
        _die("refusing to close the session this command is running from.")
    if live.get("status") == "busy":
        _die("session is busy (mid-task) - never close a busy session.")
    if live.get("kind") != "interactive":
        _die(f"session kind is '{live.get('kind')}', not 'interactive' - not handled in v1.")
    if not live.get("tmux"):
        _die("session has no tmux pane (not tmux-based) - not handled in v1.")

    try:
        os.kill(pid, 0)
    except (ProcessLookupError, TypeError):
        _die(f"pid {pid} is not running - stale ~/.claude/sessions/ file.")

    # live["tmux"] is "session:@window.%pane"; only the %pane part is addressable
    pane_id = live["tmux"].split(".")[-1]
    live_panes = subprocess.run(["tmux", "list-panes", "-a", "-F", "#{pane_id}"],
                                capture_output=True, text=True).stdout.split()
    if pane_id not in live_panes:
        _die(f"tmux pane {pane_id} (from {live['tmux']}) no longer exists - stale reference.")
    return pane_id


def _terminate(pid: int, timeout_s: float = 5.0) -> None:
    """SIGTERM the process and wait for it to actually go, or bail out.

    Never SIGKILL: Claude Code flushes its transcript on SIGTERM, and losing
    that is the one genuinely unrecoverable outcome here. If it outlives the
    timeout we leave the pane untouched rather than half-close it.
    """
    os.kill(pid, signal.SIGTERM)
    waited = 0.0
    while waited < timeout_s:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.5)
        waited += 0.5
    print(f"WARNING: pid {pid} did not exit within {timeout_s:.0f}s of SIGTERM - "
          f"leaving the pane untouched.", file=sys.stderr)
    print("WARNING: check on it manually before retrying (it may be flushing a "
          "large transcript).", file=sys.stderr)
    sys.exit(1)


def _write_tombstone(session_id: str, capture: str, closed_at: str, age: str, mem: int) -> str:
    """Save the pane's final screen to a file the pane can cat back after exit."""
    os.makedirs(CLOSE_TOMBSTONE_DIR, exist_ok=True)
    path = os.path.join(CLOSE_TOMBSTONE_DIR, f"{session_id}.txt")
    with open(path, "w", encoding="utf-8") as f:
        f.write(f"───── 🚪  CLOSED {closed_at} · idle {age} · {mem}MB reclaimed ─────\n")
        f.write(capture if capture.endswith("\n") else capture + "\n")
        f.write(f"───── resume: asm resume {session_id[:8]} ─────\n")
    return path


def _do_close(uuid: str) -> None:
    """Resolve uuid against live sessions, run safety checks, close it."""
    live = _find_live_session(uuid)
    if not live:
        _die(f"session {uuid} has no live process - nothing to close "
             f"(already exited, or from another machine).")

    pid = live["pid"]
    session_id = live["sessionId"]
    name = live.get("name") or session_id

    print(f"Target: {name} (pid {pid}, session {session_id})", flush=True)
    pane_id = _check_closeable(live)

    age_ms = int(time.time() * 1000) - int(live.get("statusUpdatedAt") or 0)
    age = _human_age(age_ms)
    mem = _rss_mb(pid)
    if mem is None:
        _die(f"pid {pid} disappeared while checking.")
    print(f"  status={live.get('status')}  idle={age}  mem={mem}MB  "
          f"pane={pane_id}  cwd={live.get('cwd')}", flush=True)

    # Capture BEFORE terminating: the conversation lives on the terminal's
    # alternate screen, which is torn down the moment the process exits.
    capture = subprocess.run(["tmux", "capture-pane", "-p", "-e", "-t", pane_id],
                             capture_output=True, text=True).stdout

    _terminate(pid)

    closed_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    tombstone_path = _write_tombstone(session_id, capture, closed_at, age, mem)

    # cat lands the text in the pane's *normal* buffer, so it survives; then
    # the resume command is pre-typed without Enter - the pane becomes its
    # own resume button.
    subprocess.run(["tmux", "send-keys", "-t", pane_id, f"cat '{tombstone_path}'", "Enter"])
    subprocess.run(["tmux", "send-keys", "-t", pane_id, f"claude --resume {session_id}"])
    subprocess.run(["tmux", "select-pane", "-t", pane_id, "-T", f"🚪  {name}"],
                   stderr=subprocess.DEVNULL)

    os.makedirs(os.path.dirname(CLOSE_LOG_PATH), exist_ok=True)
    with open(CLOSE_LOG_PATH, "a", encoding="utf-8") as f:
        f.write(json.dumps({
            "timestamp": closed_at, "sessionId": session_id, "name": name, "pid": pid,
            "pane": pane_id, "idle_minutes": age_ms // 60000,
            "mem_mb_reclaimed": mem, "tombstone": tombstone_path,
        }) + "\n")

    print(f"\033[32mClosed.\033[0m {mem}MB reclaimed. Tombstone: {tombstone_path}")


def cmd_close(opts: SearchOpts) -> None:
    """Find and close a running session. Same search as resume; only the
    action after picking one differs - see _do_close.

    Close relies entirely on ~/.claude/sessions/<pid>.json (_live_sessions())
    to know what's actually running - Codex has no equivalent surface yet
    (see DEV_DOC.md "Codex integration notes" #4), so a codex-tagged session
    can never appear in the live_only picker below. --uuid bypasses the
    picker, though, so it gets an explicit, honest check instead of falling
    through to a "no live process" message that would misleadingly imply the
    session simply isn't running rather than "not supported for this agent".
    """
    if opts.uuid:
        doc = find_by_uuid(opts.uuid)
        backend = BACKENDS.get((doc or {}).get("agent_type") or "claude", BACKENDS["claude"])
        if doc and not backend.supports_close:
            print(f"ERROR: close is not supported for {backend.name} sessions yet.",
                  file=sys.stderr)
            sys.exit(1)
        _do_close(opts.uuid)
        return
    uuid, _ = pick_session(opts, action_verb="Close", live_only=True)
    _do_close(uuid)


