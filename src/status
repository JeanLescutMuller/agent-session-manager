#!/usr/bin/env python3
"""status - Print current Claude Code session info. No LLM involved.

Usage (from within Claude Code):
  ! status
"""

import glob
import json
import os
import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, Iterator, Optional


def machine_name() -> str:
    """This machine's name: "Machine name" in ~/AGENTS.md (copy it identically)."""
    name = (os.environ.get("JR_MACHINE_NAME") or (
        subprocess.run(["scutil", "--get", "HostName"], capture_output=True, text=True).stdout
        if sys.platform == "darwin" else Path("/etc/hostname").read_text())).strip().split(".")[0]
    if not re.fullmatch(r"[A-Za-z0-9-]+", name):
        raise RuntimeError("no machine name: macOS sudo scutil --set HostName <name>; Linux sudo hostnamectl set-hostname <name>")
    return name

# -- Pricing table (USD per million tokens) ----------------------------------
# Matched by model-id prefix, longest first, so 'claude-opus-4-6-20260401'
# finds 'claude-opus-4'. A model that matches nothing reports no cost at all
# rather than $0.00 - a silent zero reads as "this session was free", which
# is the one answer guaranteed to be wrong.

PRICING = {
    "claude-opus-4":   {"input": 15.0, "output": 75.0},
    "claude-sonnet-4": {"input": 3.0,  "output": 15.0},
    "claude-haiku-4":  {"input": 0.80, "output": 4.0},
}


def match_pricing(model: str) -> Optional[Dict[str, float]]:
    """Prices for a model id, or None if the table doesn't cover it."""
    for prefix in sorted(PRICING, key=len, reverse=True):
        if model.startswith(prefix):
            return PRICING[prefix]
    return None


def format_tokens(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return str(n)


def format_duration(seconds: float) -> str:
    if seconds < 60:
        return f"{int(seconds)}s"
    minutes = int(seconds // 60)
    if minutes < 60:
        return f"{minutes}m"
    return f"{minutes // 60}h {minutes % 60}m"


def iter_entries(path: str) -> Iterator[Dict[str, Any]]:
    """Yield one dict per line of a .jsonl file, skipping blank/malformed ones."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for raw in f:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    yield json.loads(raw)
                except json.JSONDecodeError:
                    continue
    except OSError:
        return


class Stats:
    """Running totals accumulated over one transcript."""

    def __init__(self) -> None:
        self.custom_title: Optional[str] = None   # set via /rename
        self.ai_title: Optional[str] = None       # Claude Code's own title
        self.model = "(unknown)"
        self.permission_mode = "(unknown)"
        self.input_tokens = 0
        self.output_tokens = 0
        self.user_turns = 0
        self.assistant_turns = 0
        self.first_ts: Optional[str] = None
        self.last_ts: Optional[str] = None

    @property
    def title(self) -> Optional[str]:
        """An explicit /rename beats Claude Code's auto-generated title."""
        return self.custom_title or self.ai_title

    @property
    def cost(self) -> Optional[float]:
        """Estimated USD, or None when the model isn't in the pricing table."""
        prices = match_pricing(self.model)
        if prices is None:
            return None
        return (self.input_tokens * prices["input"]
                + self.output_tokens * prices["output"]) / 1_000_000

    @property
    def duration(self) -> str:
        try:
            t0 = datetime.fromisoformat(self.first_ts.replace("Z", "+00:00"))
            t1 = datetime.fromisoformat(self.last_ts.replace("Z", "+00:00"))
            return format_duration((t1 - t0).total_seconds())
        except (AttributeError, ValueError, TypeError):
            return "(unknown)"


def scan(jsonl_path: str) -> Stats:
    """Walk a session transcript once, accumulating everything we display."""
    s = Stats()
    for e in iter_entries(jsonl_path):
        etype = e.get("type", "")

        if e.get("timestamp"):
            if s.first_ts is None:
                s.first_ts = e["timestamp"]
            s.last_ts = e["timestamp"]

        if etype == "custom-title" and e.get("customTitle"):
            s.custom_title = e["customTitle"]
        elif etype == "ai-title" and e.get("aiTitle"):
            s.ai_title = e["aiTitle"]

        if etype == "user":
            # A /rename typed this session shows up as a local command whose
            # args are the new title, before any custom-title entry is written.
            if e.get("subtype") == "local_command" and "/rename" in e.get("content", ""):
                m = re.search(r"<command-args>(.*?)</command-args>", e["content"])
                if m:
                    s.custom_title = m.group(1)
            if e.get("permissionMode"):
                s.permission_mode = e["permissionMode"]
            if not e.get("subtype"):
                s.user_turns += 1

        elif etype == "assistant":
            s.assistant_turns += 1
            msg = e.get("message", {})
            s.model = msg.get("model") or s.model
            usage = msg.get("usage", {})
            s.input_tokens += usage.get("input_tokens", 0)
            s.output_tokens += usage.get("output_tokens", 0)

    return s


def main() -> None:
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        print("Not running inside Claude Code (CLAUDE_CODE_SESSION_ID not set)")
        return

    matches = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl"))
    jsonl_path = matches[0] if matches else None
    idx_path = os.path.expanduser(f"~/opt/agent-session-manager/data/indexes/{sid}.json")

    s = scan(jsonl_path) if jsonl_path else Stats()
    cost = s.cost

    print(f"Title:              {s.title or '(not set)'}")
    print(f"UUID:               {sid}")
    try:
        host = machine_name()
    except (OSError, RuntimeError):
        host = "?"
    print(f"Hostname:           {host}")
    print(f"Current WD:         {os.getcwd()}")
    print(f"JSONL file:         {jsonl_path or '(not found)'}")
    print(f"Index file:         {idx_path if os.path.exists(idx_path) else '(not found)'}")
    print(f"Model:              {s.model}")
    print(f"Turns:              {s.user_turns + s.assistant_turns} "
          f"({s.user_turns} user, {s.assistant_turns} assistant)")
    print(f"Tokens:             {format_tokens(s.input_tokens)} in / "
          f"{format_tokens(s.output_tokens)} out")
    print(f"Cost (est):         "
          f"{f'${cost:.2f}' if cost is not None else f'(no pricing for {s.model})'}")
    print(f"Duration:           {s.duration}")
    print(f"Permission mode:    {s.permission_mode}")


if __name__ == "__main__":
    main()
