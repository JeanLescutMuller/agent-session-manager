#!/usr/bin/env python3
"""status - Print current Claude Code session info. No LLM involved.

Usage (from within Claude Code):
  ! status
"""

import json
import re
import os
import glob
import time

# -- Pricing table (per million tokens) --------------------------------------

PRICING = {
    "claude-opus-4":          {"input": 15.0,  "output": 75.0},
    "claude-sonnet-4":        {"input": 3.0,   "output": 15.0},
    "claude-haiku-4":         {"input": 0.80,  "output": 4.0},
}


def _match_pricing(model: str) -> dict:
    """Find pricing for a model string like 'claude-opus-4-6-20260401'."""
    for prefix, prices in PRICING.items():
        if model.startswith(prefix):
            return prices
    return {"input": 0.0, "output": 0.0}


def _format_tokens(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return str(n)


def _format_duration(seconds: float) -> str:
    if seconds < 60:
        return f"{int(seconds)}s"
    minutes = int(seconds // 60)
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    mins = minutes % 60
    return f"{hours}h {mins}m"


def main() -> None:
    sid = os.environ.get("CLAUDE_CODE_CURRENT_SESSION_ID")
    if not sid:
        print("Not running inside Claude Code (CLAUDE_CODE_CURRENT_SESSION_ID not set)")
        return

    hostname = os.uname().nodename
    cwd = os.getcwd()

    # Find JSONL
    projects_dir = os.path.expanduser("~/.claude/projects")
    matches = glob.glob(os.path.join(projects_dir, "*", f"{sid}.jsonl"))
    jsonl_path = matches[0] if matches else None

    # Find index
    local_idx = os.path.expanduser(f"~/.csm/indexes/{sid}.json")
    idx_path = local_idx if os.path.exists(local_idx) else None

    # Defaults
    title = "(not set)"
    model = "(unknown)"
    perm_mode = "(unknown)"
    total_input = 0
    total_output = 0
    user_turns = 0
    assistant_turns = 0
    first_ts = None
    last_ts = None

    if jsonl_path and os.path.exists(jsonl_path):
        with open(jsonl_path, encoding="utf-8", errors="replace") as f:
            for raw in f:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    e = json.loads(raw)
                except json.JSONDecodeError:
                    continue

                etype = e.get("type", "")
                ts = e.get("timestamp")

                if ts:
                    if first_ts is None:
                        first_ts = ts
                    last_ts = ts

                if etype == "custom-title" and e.get("customTitle"):
                    title = e["customTitle"]
                elif etype == "user" and e.get("subtype") == "local_command" and "/rename" in e.get("content", ""):
                    m = re.search(r"<command-args>(.*?)</command-args>", e["content"])
                    if m:
                        title = m.group(1)

                if etype == "user" and e.get("permissionMode"):
                    perm_mode = e["permissionMode"]

                if etype == "user" and not e.get("subtype"):
                    user_turns += 1

                if etype == "assistant":
                    assistant_turns += 1
                    msg = e.get("message", {})
                    m_model = msg.get("model")
                    if m_model:
                        model = m_model
                    usage = msg.get("usage", {})
                    total_input += usage.get("input_tokens", 0)
                    total_output += usage.get("output_tokens", 0)
    else:
        jsonl_path = "(not found)"

    # Cost estimate
    prices = _match_pricing(model)
    cost = (total_input * prices["input"] + total_output * prices["output"]) / 1_000_000

    # Duration
    duration = ""
    if first_ts and last_ts:
        try:
            from datetime import datetime
            fmt = "%Y-%m-%dT%H:%M:%S"
            t0 = datetime.fromisoformat(first_ts.replace("Z", "+00:00"))
            t1 = datetime.fromisoformat(last_ts.replace("Z", "+00:00"))
            duration = _format_duration((t1 - t0).total_seconds())
        except Exception:
            duration = "(unknown)"

    print(f"Title:              {title}")
    print(f"UUID:               {sid}")
    print(f"Hostname:           {hostname}")
    print(f"Current WD:         {cwd}")
    print(f"JSONL file:         {jsonl_path}")
    print(f"Index file:         {idx_path or '(not found)'}")
    print(f"Model:              {model}")
    print(f"Turns:              {user_turns + assistant_turns} ({user_turns} user, {assistant_turns} assistant)")
    print(f"Tokens:             {_format_tokens(total_input)} in / {_format_tokens(total_output)} out")
    print(f"Cost (est):         ${cost:.2f}")
    print(f"Duration:           {duration or '(unknown)'}")
    print(f"Permission mode:    {perm_mode}")


if __name__ == "__main__":
    main()
