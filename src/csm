VERSION = "v4.2"
HOME = os.path.expanduser("~")
_CLAUDE_ENV = {**os.environ, "PATH": f"{HOME}/.local/bin:{os.environ.get('PATH', '/usr/bin:/bin')}"}

# -- Autoname (title generation delegated to autoname plugin) --------------

_autoname_script: Optional[str] = None


def _find_autoname_script() -> Optional[str]:
    global _autoname_script
    if _autoname_script is not None:
        return _autoname_script if _autoname_script else None
    matches = glob.glob(os.path.join(HOME, ".claude", "plugins", "cache",
                                     "claude-templates", "autoname", "*",
                                     "scripts", "session-autoname.py"))
    _autoname_script = matches[0] if matches else ""
    return _autoname_script if _autoname_script else None


_autoname_missing_warned = False


def _run_autoname(mode: str, target_path: str, overwrite: str = "nothing", source: str = "reindex") -> Tuple[Optional[str], int]:
    """Call session-autoname.py to generate a title.
    overwrite: "nothing" (fill), "llm_only" (refresh auto titles), "all" (overwrite everything).
    Returns (stdout_text, exit_code). Exit 0=success, 1=error, 2=skipped.

    Title generation is optional: if the autoname plugin isn't installed,
    reindexing must still complete (titles just fall back to untitled)."""
    global _autoname_missing_warned
    script = _find_autoname_script()
    if not script:
        if not _autoname_missing_warned:
            _autoname_missing_warned = True
            print("  NOTE: autoname plugin not installed - skipping title generation", file=sys.stderr)
        return None, 2
    cmd = ["python3", script, f"--{mode}", target_path, "--source", source]
    if overwrite != "nothing":
        cmd.extend(["--overwrite", overwrite])
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=120,
            stdin=subprocess.DEVNULL, env=_CLAUDE_ENV,
        )
        return result.stdout.strip(), result.returncode
    except subprocess.TimeoutExpired:
        return None, 1
    except Exception:
        return None, 1


# -- Settings --------------------------------------------------------------

SETTINGS_PATH = os.path.join(HOME, ".claude", "csm-settings.json")

def _load_settings() -> Dict[str, Any]:
    """Load CSM settings from ~/.claude/csm-settings.json with defaults."""
    defaults = {
        "local_projects_dir": "~/.claude/projects",
        "local_index_dir": "~/.claude/session-index-local",
    }
    try:
        with open(SETTINGS_PATH) as f:
            user = json.load(f)
        defaults.update({k: v for k, v in user.items() if isinstance(v, str) and v != ""})
    except (OSError, json.JSONDecodeError):
        pass
    return defaults

