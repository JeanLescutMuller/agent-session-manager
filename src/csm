#!/usr/bin/env python3
"""
csm - Claude Session Manager (Pure Python, local index)

Index architecture:
  reindex → builds JSON index from local .jsonl files (~/.claude/session-index-local/)
  resume  → reads from local index for fast disk I/O

Commands:
  csm resume [OPTIONS] [KEYWORD...]   Find and resume a past Claude Code session
  csm reindex                         Re-index all sessions now

  csm --version                       Show version
  csm --help                          Show this help
"""

import sys
